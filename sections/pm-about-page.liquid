{%- comment -%}
  Dedicated section for the "about" page template — renders the
  editorial About Us layout unconditionally (no page.handle check),
  so it doesn't depend on knowing the page's exact URL handle.
{%- endcomment -%}
{%- render 'pm-about-content',
  craft_image: section.settings.craft_image,
  craft_video: section.settings.craft_video
-%}

{% schema %}
{
  "name": "PM: About page",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "\"Made By Hand\" image/video" },
    { "type": "image_picker", "id": "craft_image", "label": "Image" },
    { "type": "video", "id": "craft_video", "label": "Video", "info": "Uploaded directly (not a pasted link) — overrides the image when set. Shopify generates multiple quality renditions automatically, so this stays sharp instead of one flat file stretched to fit." }
  ]
}
{% endschema %}
