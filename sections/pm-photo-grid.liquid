<div class="pm-homepage">
  <section class="pm-photo-grid-section">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="pm-section-head pm-reveal">
        {%- if section.settings.eyebrow != blank -%}<span class="pm-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="pm-serif">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="pm-photo-grid">
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}
        {%- assign tile_image = block.settings.image | default: product.featured_image -%}
        <a href="{{ product.url | default: block.settings.link | default: '#' }}" class="pm-photo-tile pm-reveal" style="transition-delay: {{ forloop.index0 | modulo: 4 | times: 90 }}ms">
          {%- if tile_image -%}
            <img src="{{ tile_image | image_url: width: 900 }}" alt="{{ tile_image.alt | escape | default: product.title | default: block.settings.fallback_label }}" loading="lazy">
          {%- else -%}
            <img src="{{ block.settings.fallback_asset | asset_url }}" alt="{{ product.title | default: block.settings.fallback_label }}" loading="lazy">
          {%- endif -%}
          {%- if product.title != blank or block.settings.fallback_label != blank -%}
            <span class="pm-photo-tile-caption">{{ product.title | default: block.settings.fallback_label }}</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "PM: Photo grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "product", "id": "product", "label": "Product (optional)" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "fallback_label", "label": "Fallback label" },
        { "type": "text", "id": "fallback_asset", "label": "Fallback theme asset filename" },
        { "type": "url", "id": "link", "label": "Fallback link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PM: Photo grid",
      "blocks": [
        { "type": "photo", "settings": {} },
        { "type": "photo", "settings": {} },
        { "type": "photo", "settings": {} },
        { "type": "photo", "settings": {} },
        { "type": "photo", "settings": {} },
        { "type": "photo", "settings": {} },
        { "type": "photo", "settings": {} },
        { "type": "photo", "settings": {} }
      ]
    }
  ]
}
{% endschema %}
