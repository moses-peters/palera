<div class="pm-homepage">
  <section class="pm-photo-grid-section{% if section.id contains 'pm-photo-grid-top' %} pm-photo-grid-section--top{% elsif section.id contains 'pm-photo-grid' %} pm-photo-grid-section--tight-top{% endif %}">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="pm-section-head pm-reveal">
        {%- if section.settings.eyebrow != blank -%}<span class="pm-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="pm-serif">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="pm-photo-grid">
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}
        {%- comment -%}
          Color variant (optional) — a plain text match against
          whichever of the product's own options is actually named
          Color/Colour, same lookup pm-collection-grid.liquid uses for
          real Color-variant products, so a merchant can point one tile
          at e.g. "Blue" without needing a separate product per color.
          Falls back to the product's own default variant when left
          blank, and to the manually uploaded picture below when no
          product is selected at all.
        {%- endcomment -%}
        {%- assign selected_variant = nil -%}
        {%- if product and block.settings.variant_color != blank -%}
          {%- assign color_option = nil -%}
          {%- for option in product.options_with_values -%}
            {%- assign option_name_downcase = option.name | downcase -%}
            {%- if option_name_downcase == 'color' or option_name_downcase == 'colour' -%}
              {%- assign color_option = option -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if color_option -%}
            {%- assign color_option_key = 'option' | append: color_option.position -%}
            {%- assign selected_variant = product.variants | where: color_option_key, block.settings.variant_color | first -%}
          {%- endif -%}
        {%- endif -%}
        {%- assign selected_variant = selected_variant | default: product.selected_or_first_available_variant -%}
        {%- assign tile_image = selected_variant.featured_image | default: product.featured_image | default: block.settings.image -%}
        {%- assign tile_image_mobile = block.settings.image_mobile -%}
        {%- assign tile_alt = tile_image.alt | escape | default: product.title | default: block.settings.fallback_label -%}
        {%- assign tile_url = product.url -%}
        {%- if product and selected_variant and block.settings.variant_color != blank -%}
          {%- assign tile_url = product.url | append: '?variant=' | append: selected_variant.id -%}
        {%- endif -%}
        {%- assign tile_price = selected_variant.price | default: product.price -%}
        <a href="{{ tile_url | default: block.settings.link | default: '#' }}" class="pm-photo-tile pm-reveal" style="transition-delay: {{ forloop.index0 | modulo: 4 | times: 90 }}ms">
          {%- if block.settings.video != blank -%}
            {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '900x' }}
          {%- elsif tile_image -%}
            {%- comment -%}
              A <picture> with a max-width source, not two <img>s shown/
              hidden by CSS, so only the one image that actually matches
              the visitor's screen is ever downloaded. Falls back to the
              same desktop image on mobile when no mobile override is set.
            {%- endcomment -%}
            <picture>
              {%- if tile_image_mobile -%}
                <source media="(max-width: 639px)" srcset="{{ tile_image_mobile | image_url: width: 900 }}">
              {%- endif -%}
              <img src="{{ tile_image | image_url: width: 900 }}" alt="{{ tile_alt }}" loading="lazy">
            </picture>
          {%- else -%}
            <img src="{{ block.settings.fallback_asset | asset_url }}" alt="{{ product.title | default: block.settings.fallback_label }}" loading="lazy">
          {%- endif -%}
          {%- if product.title != blank or block.settings.fallback_label != blank -%}
            <span class="pm-photo-tile-caption">
              <span class="pm-photo-tile-name">{{ product.title | split: ' — ' | first | default: block.settings.fallback_label }}{%- if product.title contains ' — ' %} <span class="pm-tile-color">{{ product.title | split: ' — ' | last }}</span>{%- endif -%}</span>
              {%- if tile_price -%}
                <span class="pm-photo-tile-price">
                  {%- if selected_variant == nil or block.settings.variant_color == blank -%}
                    {%- if product.price_varies -%}From {{ tile_price | money }}{%- else -%}{{ tile_price | money }}{%- endif -%}
                  {%- else -%}
                    {{ tile_price | money }}
                  {%- endif -%}
                </span>
              {%- endif -%}
            </span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "PM: Photo grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "product", "id": "product", "label": "Product (optional)" },
        { "type": "text", "id": "variant_color", "label": "Color variant (optional)", "info": "Type the exact Color option value on the product above (e.g. \"Blue\") to show that specific color's photo and price. Leave blank to use the product's default." },
        { "type": "image_picker", "id": "image", "label": "Fallback image (desktop)", "info": "Only used when no product is selected above." },
        { "type": "image_picker", "id": "image_mobile", "label": "Fallback image (mobile)", "info": "Optional — shown below 640px wide. Falls back to the desktop image when not set." },
        { "type": "video", "id": "video", "label": "Video", "info": "Uploaded directly (not a pasted link) — overrides the image when set." },
        { "type": "text", "id": "fallback_label", "label": "Fallback label" },
        { "type": "text", "id": "fallback_asset", "label": "Fallback theme asset filename" },
        { "type": "url", "id": "link", "label": "Fallback link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PM: Photo grid",
      "blocks": [
        { "type": "photo", "settings": {} },
        { "type": "photo", "settings": {} },
        { "type": "photo", "settings": {} },
        { "type": "photo", "settings": {} },
        { "type": "photo", "settings": {} },
        { "type": "photo", "settings": {} },
        { "type": "photo", "settings": {} },
        { "type": "photo", "settings": {} }
      ]
    }
  ]
}
{% endschema %}
