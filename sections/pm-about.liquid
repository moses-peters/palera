{{ 'pm-homepage.css' | asset_url | stylesheet_tag }}
{{ 'pm-about.css' | asset_url | stylesheet_tag }}

<div class="pm-homepage">

  {%- comment -%} ===== Intro / hero ===== {%- endcomment -%}
  <section class="pm-about-hero">
    {%- if section.settings.hero_image -%}
      <img src="{{ section.settings.hero_image | image_url: width: 1800 }}" alt="{{ section.settings.hero_heading }}" loading="eager">
    {%- else -%}
      <img src="{{ 'pm-about-hero.jpg' | asset_url }}" alt="{{ section.settings.hero_heading }}" loading="eager">
    {%- endif -%}
    <div class="pm-about-hero-copy">
      <span class="pm-eyebrow">{{ section.settings.hero_eyebrow }}</span>
      <h1 class="pm-serif">{{ section.settings.hero_heading }}</h1>
    </div>
  </section>

  {%- comment -%} ===== Founding statement ===== {%- endcomment -%}
  <section class="pm-statement pm-reveal">
    <p class="pm-statement-mark">{{ section.settings.statement_mark }}</p>
    <p class="pm-serif pm-statement-quote">{{ section.settings.statement_text }}</p>
  </section>

  {%- comment -%} ===== Craft / story spread ===== {%- endcomment -%}
  <section class="pm-about-spread">
    <div class="pm-about-spread-image pm-reveal">
      {%- if section.settings.story_image -%}
        <img src="{{ section.settings.story_image | image_url: width: 1400 }}" alt="{{ section.settings.story_heading }}" loading="lazy">
      {%- else -%}
        <img src="{{ 'pm-about-story.jpg' | asset_url }}" alt="{{ section.settings.story_heading }}" loading="lazy">
      {%- endif -%}
    </div>
    <div class="pm-about-spread-copy pm-reveal" style="transition-delay: 150ms">
      <span class="pm-eyebrow">{{ section.settings.story_eyebrow }}</span>
      <h2 class="pm-serif">{{ section.settings.story_heading }}</h2>
      <div class="pm-about-spread-text">{{ section.settings.story_text }}</div>
    </div>
  </section>

  {%- comment -%} ===== Values row ===== {%- endcomment -%}
  {%- if section.blocks.size > 0 -%}
    <section class="pm-about-values">
      <div class="pm-about-values-grid">
        {%- for block in section.blocks -%}
          <div class="pm-about-value pm-reveal" style="transition-delay: {{ forloop.index0 | times: 100 }}ms" {{ block.shopify_attributes }}>
            <span class="pm-about-value-index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <h3 class="pm-serif">{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ===== Closing CTA ===== {%- endcomment -%}
  <section class="pm-about-closing pm-reveal">
    <p class="pm-serif pm-about-closing-text">{{ section.settings.closing_text }}</p>
    {%- if section.settings.closing_link_label != blank -%}
      <a href="{{ section.settings.closing_link_url | default: '/collections' }}" class="pm-link">{{ section.settings.closing_link_label }}</a>
    {%- endif -%}
  </section>
</div>

<script src="{{ 'pm-homepage.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "PM: About",
  "settings": [
    {
      "type": "header",
      "content": "Intro"
    },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow", "default": "Palera Milano" },
    { "type": "text", "id": "hero_heading", "label": "Heading", "default": "Our Story" },
    {
      "type": "header",
      "content": "Founding statement"
    },
    { "type": "text", "id": "statement_mark", "label": "Mark", "default": "P M" },
    {
      "type": "textarea",
      "id": "statement_text",
      "label": "Statement",
      "default": "Palera Milano was born on the Sicilian coast, where sunlight on water first inspired a bag made to hold that same glow. What began as a single idea — that a handbag could catch the light the way the sea does — has grown into a maison built entirely on that instinct, and on the hands that carry it out, one crystal at a time."
    },
    {
      "type": "header",
      "content": "Craft spread"
    },
    { "type": "image_picker", "id": "story_image", "label": "Image" },
    { "type": "text", "id": "story_eyebrow", "label": "Eyebrow", "default": "Made By Hand" },
    { "type": "text", "id": "story_heading", "label": "Heading", "default": "Every piece, considered" },
    {
      "type": "richtext",
      "id": "story_text",
      "label": "Text",
      "default": "<p>Every Palera piece is finished by artisan hands in Italy. Crystals are set one at a time, by eye, so no two pieces catch the light quite the same way — a deliberate imperfection we've never tried to engineer out.</p><p>We work in small runs, not seasons. A piece is made when it's ordered, not stocked in anticipation of a trend, which means what you carry was made with you already in mind.</p>"
    },
    {
      "type": "header",
      "content": "Closing"
    },
    { "type": "textarea", "id": "closing_text", "label": "Closing line", "default": "Made to order, in Italy — for the way you actually live." },
    { "type": "text", "id": "closing_link_label", "label": "Link label", "default": "Shop the Collection" },
    { "type": "url", "id": "closing_link_url", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PM: About",
      "blocks": [
        { "type": "value", "settings": { "title": "Made in Italy", "text": "Every piece is cut, set, and finished within Italy, by the same small group of hands." } },
        { "type": "value", "settings": { "title": "Hand-Set Crystal", "text": "Each crystal is placed individually — no two pieces catch the light the same way." } },
        { "type": "value", "settings": { "title": "Made to Order", "text": "We build in small runs against real orders, not seasonal stock." } },
        { "type": "value", "settings": { "title": "Considered Design", "text": "Fewer, better pieces — built to be carried for years, not a season." } }
      ]
    }
  ]
}
{% endschema %}
