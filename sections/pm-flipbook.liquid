{%- comment -%}
  Standalone PDF flipbook viewer -- built for pages that are never
  linked in any nav menu (e.g. a merchant creates /pages/ss26 and
  /pages/aw27, each on its own preset of this section) so they're
  reachable only by whoever has the direct URL.

  The two current lookbooks (SS26, AW27) are bundled directly as theme
  assets (pm-lookbook-ss26.pdf / pm-lookbook-aw27.pdf), referenced by
  filename via the pdf_asset_filename setting -- there's no Shopify
  schema setting type for a generic file upload (a "file" type setting
  doesn't validate; text/URL/image/video are what's actually
  supported), so swapping in a future season's PDF means uploading it
  to the theme's Assets and updating this filename, not a plain Admin
  file picker.

  Renders the PDF's pages as images via pdf.js, then flips between them
  with a real CSS 3D page-turn (rotateY on the current page, revealing
  the next/previous one underneath) rather than a plain slide/fade --
  this is its own hand-built flip rather than a third-party flipbook
  library, since a wrong version/CDN path for an unfamiliar library
  would fail silently with no way to test it here; pdf.js alone is
  enough to build the whole effect and is a much safer, long-established
  dependency to pin a version of blind.
{%- endcomment -%}
{%- assign pdf_src = '' -%}
{%- if section.settings.pdf_asset_filename != blank -%}
  {%- assign pdf_src = section.settings.pdf_asset_filename | asset_url -%}
{%- endif -%}
<div class="pm-homepage">
  <div class="pm-flipbook-wrap">
    {%- if section.settings.heading != blank -%}
      <h1 class="pm-serif pm-flipbook-heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if pdf_src != blank -%}
      <button type="button" class="pm-flipbook-close" data-pm-flipbook-close aria-label="Exit fullscreen" hidden>✕</button>
      <p class="pm-flipbook-rotate-hint">Rotate your phone horizontally for the best view</p>
      <div class="pm-flipbook" data-pm-flipbook data-pdf-src="{{ pdf_src }}">
        <div class="pm-flipbook-page-layer" data-pm-flipbook-layer="back"></div>
        <div class="pm-flipbook-page-layer" data-pm-flipbook-layer="front"></div>
        <div class="pm-flipbook-loading" data-pm-flipbook-loading>Loading…</div>
      </div>
      <div class="pm-flipbook-controls">
        <button type="button" class="pm-flipbook-btn" data-pm-flipbook-prev aria-label="Previous page" disabled>‹</button>
        <span class="pm-flipbook-page-count" data-pm-flipbook-count></span>
        <button type="button" class="pm-flipbook-btn" data-pm-flipbook-next aria-label="Next page" disabled>›</button>
        <button type="button" class="pm-flipbook-btn pm-flipbook-btn--fullscreen" data-pm-flipbook-fullscreen aria-label="View fullscreen">⛶</button>
      </div>
    {%- else -%}
      <p class="pm-flipbook-empty">Upload a PDF in the theme editor to show it here.</p>
    {%- endif -%}
  </div>
</div>

{%- if pdf_src != blank -%}
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js" defer onload="window.pmFlipbookPdfjsReady && window.pmFlipbookPdfjsReady()"></script>
  <script>
    (function () {
      function setUpFlipbook(root) {
        if (root.dataset.pmFlipbookBound) return;
        root.dataset.pmFlipbookBound = 'true';

        var pdfSrc = root.dataset.pdfSrc;
        var backLayer = root.querySelector('[data-pm-flipbook-layer="back"]');
        var frontLayer = root.querySelector('[data-pm-flipbook-layer="front"]');
        var wrap = root.closest('.pm-flipbook-wrap');
        var prevBtn = wrap.querySelector('[data-pm-flipbook-prev]');
        var nextBtn = wrap.querySelector('[data-pm-flipbook-next]');
        var countEl = wrap.querySelector('[data-pm-flipbook-count]');
        var fullscreenBtn = wrap.querySelector('[data-pm-flipbook-fullscreen]');
        var closeBtn = wrap.querySelector('[data-pm-flipbook-close]');

        var pdfDoc = null;
        var virtualPages = []; // [{ page: <1-based PDF page>, part: 'full' | 'left' | 'right' }, ...]
        var pageCount = 0;
        var currentIndex = 0; // 0-based, into virtualPages
        var fullPageCanvasCache = {}; // real PDF page number -> rendered canvas
        var croppedImageCache = {}; // virtual index -> { url, ratio }
        var isFlipping = false;

        {%- comment -%}
          Splitting each spread into left/right virtual pages on mobile
          (shipped earlier) turned out not to be what was wanted -- the
          real page count (16) needs to stay 16 on every device, just
          shown bigger on mobile. virtualPages is kept as a concept
          (rather than reverting to raw page numbers everywhere) since
          getVirtualImage/showPage/flip all already key off it, but
          every entry is 'full' now, on every device.
        {%- endcomment -%}
        function buildVirtualPages() {
          for (var i = 1; i <= pdfDoc.numPages; i++) {
            virtualPages.push({ page: i, part: 'full' });
          }
          pageCount = virtualPages.length;
          return Promise.resolve();
        }

        function renderFullPageCanvas(pageNumber) {
          if (fullPageCanvasCache[pageNumber]) {
            return Promise.resolve(fullPageCanvasCache[pageNumber]);
          }
          return pdfDoc.getPage(pageNumber).then(function (page) {
            var baseViewport = page.getViewport({ scale: 1 });
            var scale = 2200 / baseViewport.width;
            var viewport = page.getViewport({ scale: scale });
            var canvas = document.createElement('canvas');
            canvas.width = viewport.width;
            canvas.height = viewport.height;
            var ctx = canvas.getContext('2d');
            return page.render({ canvasContext: ctx, viewport: viewport }).promise.then(function () {
              fullPageCanvasCache[pageNumber] = canvas;
              return canvas;
            });
          });
        }

        function getVirtualImage(virtualIndex) {
          if (croppedImageCache[virtualIndex]) {
            return Promise.resolve(croppedImageCache[virtualIndex]);
          }
          var entry = virtualPages[virtualIndex];
          return renderFullPageCanvas(entry.page).then(function (canvas) {
            var resultCanvas = canvas;
            if (entry.part !== 'full') {
              var halfWidth = Math.round(canvas.width / 2);
              var cropped = document.createElement('canvas');
              cropped.width = halfWidth;
              cropped.height = canvas.height;
              var ctx = cropped.getContext('2d');
              var sourceX = entry.part === 'left' ? 0 : halfWidth;
              ctx.drawImage(canvas, sourceX, 0, halfWidth, canvas.height, 0, 0, halfWidth, canvas.height);
              resultCanvas = cropped;
            }
            var imageData = {
              url: resultCanvas.toDataURL('image/jpeg', 0.9),
              ratio: resultCanvas.width / resultCanvas.height
            };
            croppedImageCache[virtualIndex] = imageData;
            return imageData;
          });
        }

        function updateButtons() {
          prevBtn.disabled = currentIndex <= 0;
          nextBtn.disabled = currentIndex >= pageCount - 1;
          countEl.textContent = (currentIndex + 1) + ' / ' + pageCount;
        }

        function setLayerImage(layer, imageData) {
          layer.style.backgroundImage = 'url(' + imageData.url + ')';
          root.style.setProperty('--pm-flipbook-ratio', imageData.ratio);
        }

        function showPage(index) {
          getVirtualImage(index).then(function (imageData) {
            setLayerImage(frontLayer, imageData);
            root.classList.add('is-ready');
            updateButtons();
            // Prefetch neighbors so the next flip has no visible delay.
            if (index + 1 < pageCount) getVirtualImage(index + 1);
            if (index > 0) getVirtualImage(index - 1);
          });
        }

        function flip(direction) {
          if (isFlipping) return;
          var targetIndex = currentIndex + direction;
          if (targetIndex < 0 || targetIndex >= pageCount) return;

          isFlipping = true;
          getVirtualImage(targetIndex).then(function (imageData) {
            setLayerImage(backLayer, imageData);
            var flipClass = direction > 0 ? 'is-flipping-next' : 'is-flipping-prev';
            root.classList.add(flipClass);

            var onEnd = function () {
              frontLayer.removeEventListener('transitionend', onEnd);
              root.classList.remove(flipClass);
              frontLayer.style.transition = 'none';
              setLayerImage(frontLayer, imageData);
              // Force reflow so the transition re-enables cleanly for the next flip.
              void frontLayer.offsetWidth;
              frontLayer.style.transition = '';
              currentIndex = targetIndex;
              updateButtons();
              isFlipping = false;
            };
            frontLayer.addEventListener('transitionend', onEnd);
          });
        }

        prevBtn.addEventListener('click', function () { flip(-1); });
        nextBtn.addEventListener('click', function () { flip(1); });

        {%- comment -%}
          Swipe left/right to change pages -- mainly for mobile
          fullscreen, where the prev/next buttons are hidden entirely
          to save space, but harmless to enable everywhere (desktop
          touchscreens included) since it doesn't replace the buttons,
          just adds another way to flip. Only counts as a swipe when
          the horizontal movement clearly dominates the vertical, so an
          up/down scroll gesture on the inline (non-fullscreen) view
          isn't mistaken for a page turn.
        {%- endcomment -%}
        var touchStartX = 0;
        var touchStartY = 0;
        root.addEventListener('touchstart', function (e) {
          touchStartX = e.changedTouches[0].clientX;
          touchStartY = e.changedTouches[0].clientY;
        }, { passive: true });
        root.addEventListener('touchend', function (e) {
          var deltaX = e.changedTouches[0].clientX - touchStartX;
          var deltaY = e.changedTouches[0].clientY - touchStartY;
          if (Math.abs(deltaX) < 40 || Math.abs(deltaX) < Math.abs(deltaY) * 1.5) return;
          flip(deltaX < 0 ? 1 : -1);
        }, { passive: true });

        {%- comment -%}
          A fixed-position overlay covering the whole viewport, toggled
          purely with a CSS class -- not the browser's real Fullscreen
          API, since iOS Safari (the one device this was specifically
          asked to also work on) doesn't support requestFullscreen on
          ordinary elements at all, only on <video>. This overlay
          approach works identically everywhere instead of needing a
          separate, untestable fallback path for iOS.
        {%- endcomment -%}
        function setFullscreen(on) {
          wrap.classList.toggle('is-fullscreen', on);
          closeBtn.hidden = !on;
          document.body.classList.toggle('pm-flipbook-lock-scroll', on);
          fullscreenBtn.setAttribute('aria-label', on ? 'Exit fullscreen' : 'View fullscreen');
        }
        fullscreenBtn.addEventListener('click', function () { setFullscreen(true); });
        closeBtn.addEventListener('click', function () { setFullscreen(false); });

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && wrap.classList.contains('is-fullscreen')) {
            setFullscreen(false);
            return;
          }
          if (!wrap.contains(document.activeElement) && document.activeElement !== document.body) return;
          if (e.key === 'ArrowRight') flip(1);
          if (e.key === 'ArrowLeft') flip(-1);
        });

        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
        pdfjsLib.getDocument(pdfSrc).promise.then(function (doc) {
          pdfDoc = doc;
          return buildVirtualPages();
        }).then(function () {
          showPage(0);
        });
      }

      function initAll() {
        if (typeof pdfjsLib === 'undefined') return;
        document.querySelectorAll('[data-pm-flipbook]').forEach(setUpFlipbook);
      }

      window.pmFlipbookPdfjsReady = initAll;
      if (typeof pdfjsLib !== 'undefined') initAll();
    })();
  </script>
{%- endif -%}

<style>
  .pm-flipbook-wrap { max-width: 1200px; margin: 0 auto; padding: clamp(32px, 6vw, 64px) var(--pm-pad); text-align: center; }
  .pm-flipbook-heading { margin-bottom: clamp(20px, 3vw, 32px); }
  .pm-flipbook {
    position: relative; width: 100%; aspect-ratio: var(--pm-flipbook-ratio, 0.72);
    margin: 0 auto; perspective: 2400px; background: var(--pm-sable, #f2f2f2);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.12);
  }
  .pm-flipbook-page-layer {
    position: absolute; inset: 0; background-size: contain; background-repeat: no-repeat; background-position: center;
    background-color: #fff; backface-visibility: hidden; transition: transform 0.7s cubic-bezier(0.645, 0.045, 0.355, 1);
  }
  .pm-flipbook-page-layer[data-pm-flipbook-layer="back"] { z-index: 1; }
  .pm-flipbook-page-layer[data-pm-flipbook-layer="front"] { z-index: 2; transform-origin: right center; transform: rotateY(0deg); }
  .pm-flipbook.is-flipping-next .pm-flipbook-page-layer[data-pm-flipbook-layer="front"] { transform: rotateY(-150deg); box-shadow: -20px 0 40px rgba(0, 0, 0, 0.2); }
  .pm-flipbook.is-flipping-prev .pm-flipbook-page-layer[data-pm-flipbook-layer="front"] { transform-origin: left center; transform: rotateY(150deg); box-shadow: 20px 0 40px rgba(0, 0, 0, 0.2); }
  .pm-flipbook-loading {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--pm-muted); z-index: 3;
    background: var(--pm-sable, #f2f2f2); transition: opacity 0.3s var(--pm-ease); pointer-events: none;
  }
  .pm-flipbook.is-ready .pm-flipbook-loading { opacity: 0; }
  .pm-flipbook-controls { margin-top: clamp(20px, 3vw, 32px); display: flex; align-items: center; justify-content: center; gap: 20px; }
  .pm-flipbook-btn {
    background: none; border: 1px solid var(--pm-line); width: 40px; height: 40px; cursor: pointer;
    font-size: 18px; color: var(--pm-ink); transition: background 0.2s var(--pm-ease), color 0.2s var(--pm-ease);
  }
  .pm-flipbook-btn:hover:not(:disabled) { background: var(--pm-ink); color: #fff; }
  .pm-flipbook-btn:disabled { opacity: 0.3; cursor: not-allowed; }
  .pm-flipbook-page-count { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--pm-muted); min-width: 70px; }
  .pm-flipbook-empty { padding: 60px var(--pm-pad); text-align: center; color: var(--pm-muted); }
  .pm-flipbook-rotate-hint { display: none; }

  /* ===== Fullscreen (a fixed overlay toggled by class, not the real
     Fullscreen API -- see the JS comment on setFullscreen for why) ===== */
  body.pm-flipbook-lock-scroll { overflow: hidden; }
  .pm-flipbook-wrap.is-fullscreen {
    position: fixed; inset: 0; z-index: 9999; max-width: none;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: clamp(16px, 4vw, 40px); background: #000;
  }
  .pm-flipbook-wrap.is-fullscreen .pm-flipbook-heading { display: none; }
  .pm-flipbook-wrap.is-fullscreen .pm-flipbook {
    width: auto; height: min(82vh, calc(90vw / var(--pm-flipbook-ratio, 0.72)));
    max-width: 90vw; box-shadow: none;
  }
  .pm-flipbook-wrap.is-fullscreen .pm-flipbook-controls .pm-flipbook-page-count,
  .pm-flipbook-wrap.is-fullscreen .pm-flipbook-btn { color: #fff; border-color: rgba(255, 255, 255, 0.4); }
  .pm-flipbook-wrap.is-fullscreen .pm-flipbook-btn:hover:not(:disabled) { background: #fff; color: #000; }
  .pm-flipbook-close {
    display: none; position: fixed; top: clamp(16px, 3vw, 28px); right: clamp(16px, 3vw, 28px); z-index: 10000;
    background: none; border: 1px solid rgba(255, 255, 255, 0.4); color: #fff;
    width: 40px; height: 40px; font-size: 16px; cursor: pointer;
    transition: background 0.2s var(--pm-ease), color 0.2s var(--pm-ease);
  }
  .pm-flipbook-close:hover { background: #fff; color: #000; }
  .pm-flipbook-wrap.is-fullscreen .pm-flipbook-close:not([hidden]) { display: block; }

  /* ===== Mobile sizing -- desktop is untouched by anything below.
     Scoped to portrait specifically (not just a width breakpoint): a
     landscape spread page fit to a narrow PORTRAIT screen's width
     always leaves empty space above/below (its shape just doesn't
     match a tall narrow screen) -- rotating the phone to landscape
     gives a wide-enough viewport that the same sizing desktop already
     uses (confirmed working well) applies on its own, no separate
     "rotated" mode needed. This block (and the rotate hint below) only
     ever apply in portrait, so landscape mobile is identical to
     desktop automatically. ===== */
  @media (max-width: 768px) and (orientation: portrait) {
    .pm-flipbook-wrap { padding: 16px 12px; }
    .pm-flipbook-rotate-hint {
      display: block; margin-bottom: 16px; font-size: 11px; letter-spacing: 0.08em;
      text-transform: uppercase; color: var(--pm-muted);
    }
    .pm-flipbook-wrap:not(.is-fullscreen) .pm-flipbook {
      width: auto; max-width: 94vw; margin: 0 auto;
      height: min(72vh, calc(94vw / var(--pm-flipbook-ratio, 0.72)));
    }
    .pm-flipbook-wrap.is-fullscreen { padding: 10px; }
    {%- comment -%}
      The prev/next/count row is dropped entirely in mobile fullscreen
      -- swipe (see the touchstart/touchend handlers above) replaces it
      as the way to change pages, and the vertical space it used to
      take is given back to the page image itself.
    {%- endcomment -%}
    .pm-flipbook-wrap.is-fullscreen .pm-flipbook-controls { display: none; }
    .pm-flipbook-wrap.is-fullscreen .pm-flipbook {
      max-width: 98vw;
      height: min(94vh, calc(98vw / var(--pm-flipbook-ratio, 0.72)));
    }
    .pm-flipbook-wrap.is-fullscreen .pm-flipbook-rotate-hint {
      position: fixed; top: clamp(16px, 3vw, 28px); left: 50%; transform: translateX(-50%);
      margin: 0; color: rgba(255, 255, 255, 0.8); z-index: 10000;
    }
    .pm-flipbook-wrap.is-fullscreen .pm-flipbook-close {
      width: 28px; height: 28px; font-size: 12px;
      top: clamp(10px, 2vw, 16px); right: clamp(10px, 2vw, 16px);
    }
  }
</style>

{% schema %}
{
  "name": "PM: Flipbook",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "pdf_asset_filename", "label": "Bundled PDF filename", "info": "Filename of a PDF uploaded to the theme's Assets (e.g. pm-lookbook-ss26.pdf)." }
  ],
  "presets": [{ "name": "PM: Flipbook" }]
}
{% endschema %}
