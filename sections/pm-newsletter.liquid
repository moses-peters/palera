<div class="pm-homepage">
  <section class="pm-newsletter pm-reveal">
    {%- if section.settings.eyebrow != blank -%}<span class="pm-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2 class="pm-serif">{{ section.settings.heading }}</h2>

    <form class="pm-newsletter-form" data-klaviyo-signup-form data-klaviyo-list-id="{{ section.settings.klaviyo_list_id }}">
      <label for="PmNewsletterEmail-{{ section.id }}" class="pm-visually-hidden">Email address</label>
      <input
        id="PmNewsletterEmail-{{ section.id }}"
        type="email"
        name="email"
        class="pm-newsletter-input pm-serif"
        placeholder="Your email address"
        required
      >
      <button type="submit" class="pm-newsletter-submit">Subscribe</button>
      <p class="pm-newsletter-message" data-klaviyo-signup-message hidden></p>
    </form>
  </section>
</div>

<script src="{{ 'pm-klaviyo-signup.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "PM: Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Correspondence" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stay close to the maison" },
    {
      "type": "text",
      "id": "klaviyo_list_id",
      "label": "Klaviyo list ID",
      "default": "YrD2Vj",
      "info": "Defaults to the \"Newsletter\" list created for this signup form."
    }
  ],
  "presets": [{ "name": "PM: Newsletter" }]
}
{% endschema %}
