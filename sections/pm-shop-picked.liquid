{%- comment -%}
  A hand-curated shop grid, styled exactly like the real Shop All grid
  (pm-collection-grid) but driven by picking individual products as
  blocks instead of a Shopify Collection's product list — built for
  the AW27 page, where wiring up a real Collection + alternate
  template kept hitting sync/assignment friction. Add a "Product"
  block per piece (skip it — no tile renders — if you leave the
  product picker on a block empty) and interleave "Editorial break"
  blocks wherever you want a photo/video moment in the grid. No family
  filter, no sort — just banner-then-grid, in whatever order the
  blocks are in.
{%- endcomment -%}
{{ 'pm-homepage.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Count only blocks with a product actually picked, so an empty slot
  doesn't inflate the piece count or leave a gap in the grid.
{%- endcomment -%}
{%- assign piece_count = 0 -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'product' and block.settings.product != blank -%}
    {%- assign piece_count = piece_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

<div class="pm-homepage">
  <div class="pm-collection-bar">
    <a href="{{ section.settings.back_url | default: '/collections' }}" class="pm-collection-back">
      ← {{ section.settings.back_label }}
    </a>
    <div class="pm-collection-bar-right">
      <span class="pm-eyebrow">{{ piece_count }} {% if piece_count == 1 %}piece{% else %}pieces{% endif %}</span>
    </div>
  </div>

  <div class="pm-collection-header">
    {%- if section.settings.eyebrow != blank -%}<span class="pm-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h1 class="pm-serif pm-collection-name">{{ section.settings.heading }}</h1>
    {%- if section.settings.note != blank -%}
      <p class="pm-serif pm-collection-note">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>

  <div class="pm-collection-grid-wrap">
    {%- if piece_count == 0 -%}
      <p class="pm-collection-empty">{{ section.settings.empty_label }}</p>
    {%- else -%}
      <div class="pm-plp-grid">
        {%- assign tile_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'product' -%}
              {%- assign product = block.settings.product -%}
              {%- if product != blank -%}
                {%- assign tile_index = tile_index | plus: 1 -%}
                {%- comment -%}
                  Same per-tile logic as pm-collection-grid: split each
                  color into its own tile when the product has a real
                  Color variant option, and strip any " — Color" suffix
                  baked into the product's own title either way.
                {%- endcomment -%}
                {%- assign color_option = nil -%}
                {%- for option in product.options_with_values -%}
                  {%- assign option_name_downcase = option.name | downcase -%}
                  {%- if option_name_downcase == 'color' or option_name_downcase == 'colour' -%}
                    {%- assign color_option = option -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- if color_option -%}
                  {%- assign color_values = color_option.values -%}
                  {%- assign color_option_key = 'option' | append: color_option.position -%}
                {%- else -%}
                  {%- assign color_values = 'x' | split: ',' -%}
                {%- endif -%}
                {%- for color_value in color_values -%}
                  {%- assign tile_name = product.title | split: ' — ' | first -%}
                  {%- if color_option -%}
                    {%- assign tile_variant = product.variants | where: color_option_key, color_value | first -%}
                    {%- assign tile_price_varies = false -%}
                  {%- else -%}
                    {%- assign tile_variant = product.selected_or_first_available_variant -%}
                    {%- assign tile_price_varies = product.price_varies -%}
                  {%- endif -%}
                  {%- assign tile_image = tile_variant.featured_image | default: product.featured_image -%}
                  {%- assign tile_price = tile_variant.price | default: product.price -%}
                  <a href="{{ product.url }}{% if tile_variant %}?variant={{ tile_variant.id }}{% endif %}" class="pm-plp-tile pm-reveal" style="transition-delay: {{ tile_index | modulo: 8 | times: 70 }}ms" {{ block.shopify_attributes }}>
                    <div class="pm-plp-tile-image">
                      {%- if tile_image -%}
                        <img src="{{ tile_image | image_url: width: 900 }}" alt="{{ tile_image.alt | escape | default: tile_name }}" loading="lazy">
                      {%- else -%}
                        {% render 'pm-media-placeholder', label: 'Photo', hover: true %}
                      {%- endif -%}
                    </div>
                    <div class="pm-plp-tile-info">
                      <span class="pm-plp-tile-name">{{ tile_name }}</span>
                      <span class="pm-plp-tile-price">
                        {%- if tile_price_varies -%}From {{ tile_price | money }}{%- else -%}{{ tile_price | money }}{%- endif -%}
                      </span>
                    </div>
                  </a>
                {%- endfor -%}
              {%- endif -%}

            {%- when 'editorial_break' -%}
              {%- assign is_full = block.settings.full_width -%}
              <div class="pm-plp-tile pm-plp-campaign-tile{% if is_full %} pm-plp-campaign-tile--full{% endif %}" aria-hidden="true" {{ block.shopify_attributes }}>
                <div class="pm-plp-tile-image pm-plp-tile-image--campaign">
                  {%- if block.settings.video_url != blank -%}
                    <video autoplay muted loop playsinline{% if block.settings.image %} poster="{{ block.settings.image | image_url: width: 1800 }}"{% endif %}>
                      <source src="{{ block.settings.video_url }}" type="video/mp4">
                    </video>
                  {%- elsif block.settings.image -%}
                    <img src="{{ block.settings.image | image_url: width: 1800 }}" alt="{{ block.settings.image.alt | escape | default: block.settings.caption }}" loading="lazy">
                  {%- else -%}
                    {% render 'pm-media-placeholder', label: 'Campaign Photo' %}
                  {%- endif -%}
                </div>
                {%- if block.settings.caption != blank -%}
                  <p class="pm-eyebrow pm-plp-campaign-caption">{{ block.settings.caption }}</p>
                {%- endif -%}
              </div>

          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<script src="{{ 'pm-homepage.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "PM: Shop (picked)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "AW27" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Collection" },
    { "type": "text", "id": "note", "label": "Note" },
    { "type": "text", "id": "back_label", "label": "Back link label", "default": "All Collections" },
    { "type": "url", "id": "back_url", "label": "Back link URL" },
    { "type": "text", "id": "empty_label", "label": "Empty message", "default": "Pieces are being finished by hand — the collection lands here shortly." }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" }
      ]
    },
    {
      "type": "editorial_break",
      "name": "Editorial break",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "video_url", "label": "Video URL (.mp4)", "info": "Overrides the image when set." },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false }
      ]
    }
  ]
}
{% endschema %}
