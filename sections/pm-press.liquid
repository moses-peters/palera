{{ 'pm-homepage.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Press/editorial mentions. Ships with placeholder entries (blank link,
  obviously-a-placeholder copy) so the section is clearly marked as
  needing real content — swap each block's publication/title/link/logo
  via the theme editor once articles are in hand.
{%- endcomment -%}
<div class="pm-homepage">
  <section class="pm-press">
    <div class="pm-section-head pm-reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="pm-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="pm-serif">{{ section.settings.heading }}</h2>{%- endif -%}
    </div>

    <div class="pm-press-list">
      {%- for block in section.blocks -%}
        {%- assign is_linkable = false -%}
        {%- if block.settings.link != blank -%}{%- assign is_linkable = true -%}{%- endif -%}
        <{% if is_linkable %}a href="{{ block.settings.link }}" target="_blank" rel="noopener"{% else %}div{% endif %}
          class="pm-press-item pm-reveal{% unless is_linkable %} pm-press-item--soon{% endunless %}"
          style="transition-delay: {{ forloop.index0 | times: 70 }}ms"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.logo -%}
            <img class="pm-press-logo" src="{{ block.settings.logo | image_url: width: 300 }}" alt="{{ block.settings.publication | escape }}" loading="lazy">
          {%- else -%}
            <span class="pm-press-publication pm-serif">{{ block.settings.publication }}</span>
          {%- endif -%}
          {%- if block.settings.article_title != blank -%}
            <span class="pm-press-title">{{ block.settings.article_title }}</span>
          {%- endif -%}
        </{% if is_linkable %}a{% else %}div{% endif %}>
      {%- endfor -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "PM: Press",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "As Seen In" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Press & Editorial" }
  ],
  "blocks": [
    {
      "type": "mention",
      "name": "Press mention",
      "settings": [
        { "type": "text", "id": "publication", "label": "Publication name", "default": "Publication Name" },
        { "type": "text", "id": "article_title", "label": "Article title (optional)", "default": "Add the article headline here" },
        { "type": "url", "id": "link", "label": "Link to article", "info": "Leave blank until the real article link is ready — the tile shows as \"Coming soon\" until then." },
        { "type": "image_picker", "id": "logo", "label": "Publication logo (optional)", "info": "Shown instead of the publication name text when set." }
      ]
    }
  ],
  "presets": [
    {
      "name": "PM: Press",
      "blocks": [
        { "type": "mention", "settings": {} },
        { "type": "mention", "settings": {} },
        { "type": "mention", "settings": {} },
        { "type": "mention", "settings": {} }
      ]
    }
  ]
}
{% endschema %}
