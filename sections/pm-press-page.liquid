        { "type": "mention", "settings": { "publication": "Beesness", "headline": "Palera Milano accelera l'espansione retail globale", "link": "https://www.beesness.it/2026/05/11/palera-milano-accelera-lespansione-retail-globale/" } },
        { "type": "mention", "settings": { "publication": "Affari Italiani", "headline": "Palera Milano accelera l'espansione retail globale", "link": "https://www.affaritaliani.it/milano/milan-show-biz/paler-milano-accelera-espansione-retail-globale.html" } },
        { "type": "mention", "settings": { "publication": "Press", "headline": "More Coverage", "excerpt": "Additional recognition — updated as it comes in." } }
      ]
    }
  ]
}
{% endschema %}
