{%- comment -%}
  "Shop" landing page — quick links + the 9-family grid + hover preview
  (pm-shop-menu), same content that used to only exist as the header's
  "Shop" dropdown. Lives at /collections (see templates/list-collections.json),
  a real Shopify route that needs no Collection/Page resource created in
  Admin. Clicking "Shop" in the header goes here — just the family
  picker, no product grid — and clicking a family from here goes on to
  that family's actual products (/collections/all?family=..., handled
  by pm-collection-grid).

  The 9 families are a fixed, known list (see snippets/pm-family-data),
  so each gets its own named image setting here rather than open-ended
  blocks — one clearly-labeled picker per family, no chance of a typo'd
  family name leaving an image unmatched. pm-shop-menu is rendered (not
  included), which runs in an isolated scope, so each image has to be
  passed in explicitly as a render parameter.
{%- endcomment -%}
{{ 'pm-homepage.css' | asset_url | stylesheet_tag }}

{%- render 'pm-shop-menu',
  clutches_image: section.settings.clutches_image,
  clutches_video: section.settings.clutches_video,
  accessories_image: section.settings.accessories_image,
  accessories_video: section.settings.accessories_video,
  pouches_image: section.settings.pouches_image,
  pouches_video: section.settings.pouches_video,
  wallets_image: section.settings.wallets_image,
  wallets_video: section.settings.wallets_video,
  maxi_roma_image: section.settings.maxi_roma_image,
  maxi_roma_video: section.settings.maxi_roma_video,
  mini_milano_image: section.settings.mini_milano_image,
  mini_milano_video: section.settings.mini_milano_video,
  mini_roma_image: section.settings.mini_roma_image,
  mini_roma_video: section.settings.mini_roma_video,
  santorini_image: section.settings.santorini_image,
  santorini_video: section.settings.santorini_video,
  wood_net_hobo_image: section.settings.wood_net_hobo_image,
  wood_net_hobo_video: section.settings.wood_net_hobo_video
-%}

