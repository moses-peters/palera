{%- comment -%}
  "Shop" landing page — quick links + the 9-family grid + hover preview
  (pm-shop-menu), same content that used to only exist as the header's
  "Shop" dropdown. Lives at /collections (see templates/list-collections.json),
  a real Shopify route that needs no Collection/Page resource created in
  Admin. Clicking "Shop" in the header goes here — just the family
  picker, no product grid — and clicking a family from here goes on to
  that family's actual products (/collections/all?family=..., handled
  by pm-collection-grid).
{%- endcomment -%}
{{ 'pm-homepage.css' | asset_url | stylesheet_tag }}

<div class="pm-homepage">
  <div class="pm-collection-header">
    <span class="pm-eyebrow">Shop</span>
    <h1 class="pm-serif pm-collection-name">Browse by Family</h1>
  </div>
</div>

{%- render 'pm-shop-menu' -%}

{% schema %}
{
  "name": "PM: Shop browse",
  "settings": []
}
{% endschema %}
