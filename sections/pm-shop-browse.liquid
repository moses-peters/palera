{%- comment -%}
  Top-of-page "Shop" browse section — quick links + the 9-family grid +
  hover preview (pm-shop-menu), same content that used to only exist as
  the header's "Shop" dropdown. It lives here, at the top of the Shop
  All page (see templates/collection.json), so clicking "Shop" in the
  header is a real page visit instead of opening a hovering overlay.
{%- endcomment -%}
{{ 'pm-homepage.css' | asset_url | stylesheet_tag }}

<div class="pm-homepage">
  <div class="pm-collection-header">
    {%- comment -%}
      h2, not h1 — pm-collection-grid below still owns the page's one
      real h1 (the actual collection title). This is reused
      .pm-collection-header/.pm-collection-name styling for a matching
      look, not a second page heading.
    {%- endcomment -%}
    <span class="pm-eyebrow">Shop</span>
    <h2 class="pm-serif pm-collection-name">Browse by Family</h2>
  </div>
</div>

{%- render 'pm-shop-menu' -%}

{% schema %}
{
  "name": "PM: Shop browse",
  "settings": []
}
{% endschema %}
