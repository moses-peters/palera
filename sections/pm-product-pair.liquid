<div class="pm-homepage">
  <div class="pm-product-pair">
    {%- for block in section.blocks limit: 2 -%}
      {%- assign product = block.settings.product -%}
      {%- assign tile_image = block.settings.image | default: product.featured_image -%}
      {%- assign focal_x = block.settings.focal_x | default: 50 -%}
      {%- assign focal_y = block.settings.focal_y | default: 50 -%}
      <a href="{{ product.url | default: block.settings.link | default: '#' }}" class="pm-product-pair-half pm-reveal" style="transition-delay: {{ forloop.index0 | times: 120 }}ms; --pm-focal: {{ focal_x }}% {{ focal_y }}%;">
        {%- if block.settings.video != blank -%}
          {%- comment -%}
            Responsive <source> tags, no JS. Liquid only exposes two
            renditions on this video object (HLS + the flat 1080p MP4) —
            it does not expose the smaller MP4 renditions Shopify also
            generates, even though they exist (confirmed via the Admin
            API). We reconstruct the small MP4's URL from the 1080p
            one, since Shopify's CDN filenames only differ in the
            rendition label and share the same job id. If that pattern
            ever doesn't match (e.g. a differently-encoded replacement
            video), pm_sd_url safely falls back to the same 1080p file
            instead of a broken link — heavier, never broken.

            Native autoplay + muted + playsinline is the one approach
            that has reliably worked across every browser we've tried
            (this is what the original site used) — the previous
            JS-triggered play() attempt was fixing a real bandwidth
            problem but kept breaking playback on real devices, so
            we're back to the reliable native approach and getting the
            bandwidth saving from the source itself instead: mobile
            gets a real ~480p/1.5Mbps file (~4.5MB for this video)
            instead of the flat 1080p/7.2Mbps one (~22MB) — an ~80%
            cut, still playing natively and automatically everywhere.
          {%- endcomment -%}
          {%- assign pm_video = block.settings.video -%}
          {%- assign pm_hd_source = pm_video.sources | where: 'format', 'mp4' | first -%}
          {%- assign pm_hls_source = pm_video.sources | where: 'format', 'm3u8' | first -%}
          {%- assign pm_sd_url = pm_hd_source.url | replace: 'HD-1080p-7.2Mbps', 'SD-480p-1.5Mbps' -%}
          <video class="pm-tile-video" autoplay muted loop playsinline preload="auto" poster="{{ pm_video.preview_image | image_url: width: 1400 }}">
            {%- if pm_hls_source -%}
              <source media="(min-width: 750px)" src="{{ pm_hls_source.url }}" type="{{ pm_hls_source.mime_type }}">
            {%- endif -%}
            {%- if pm_hd_source -%}
              <source media="(min-width: 750px)" src="{{ pm_hd_source.url }}" type="{{ pm_hd_source.mime_type }}">
              <source src="{{ pm_sd_url }}" type="{{ pm_hd_source.mime_type }}">
            {%- endif -%}
          </video>
        {%- elsif tile_image -%}
          <picture>
            {%- if block.settings.image_mobile -%}
              <source media="(max-width: 639px)" srcset="{{ block.settings.image_mobile | image_url: width: 1400 }}">
            {%- endif -%}
            <img src="{{ tile_image | image_url: width: 1400 }}" alt="{{ tile_image.alt | escape | default: product.title | default: block.settings.fallback_label }}" loading="lazy">
          </picture>
        {%- else -%}
          <img src="{{ block.settings.fallback_asset | default: 'pm-drive-product-a.jpg' | asset_url }}" alt="{{ product.title | default: block.settings.fallback_label }}" loading="lazy">
        {%- endif -%}
        <div class="pm-product-pair-caption">
          <span class="pm-serif">{{ product.title | split: ' — ' | first | default: block.settings.fallback_label }}{%- if product.title contains ' — ' %} <span class="pm-tile-color">{{ product.title | split: ' — ' | last }}</span>{%- endif -%}</span>
          {%- if product.price -%}
            <span class="pm-product-pair-price">
              {%- if product.price_varies -%}From {{ product.price | money }}{%- else -%}{{ product.price | money }}{%- endif -%}
            </span>
          {%- endif -%}
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "PM: Product pair",
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Image override (desktop)" },
        { "type": "image_picker", "id": "image_mobile", "label": "Image override (mobile)", "info": "Optional — shown below 640px wide. Falls back to the desktop image/product photo when not set." },
        { "type": "video", "id": "video", "label": "Video", "info": "Uploaded directly (not a pasted link) — overrides the image when set." },
        { "type": "text", "id": "fallback_label", "label": "Fallback label" },
        { "type": "text", "id": "fallback_asset", "label": "Fallback theme asset filename", "info": "Used only if no product/image is set" },
        { "type": "url", "id": "link", "label": "Fallback link" },
        { "type": "range", "id": "focal_x", "label": "Focal point — horizontal", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50, "info": "Lower = crop shows more of the image's left side." },
        { "type": "range", "id": "focal_y", "label": "Focal point — vertical", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50, "info": "Lower = crop shows more of the image's top." }
      ]
    }
  ],
  "presets": [
    {
      "name": "PM: Product pair",
      "blocks": [
        { "type": "product", "settings": { "fallback_label": "Signature Clutch" } },
        { "type": "product", "settings": { "fallback_label": "Crystal Mini" } }
      ]
    }
  ]
}
{% endschema %}
