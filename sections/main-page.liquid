{%- comment -%}
  Generic fallback for any page on the default template. About Us,
  Press and the email-preferences confirmation page don't use this —
  they're rendered by their own enabled sections in page.json instead
  (pm-about, pm-press, pm-email-preferences), which is why it's scoped
  away from those specific handles here rather than left to render
  everywhere: this section is now enabled in page.json (every other
  page on the default template, e.g. the legal pages, has no
  dedicated section of its own and needs something to actually show
  its title/body content), and without this guard it would stack a
  second, empty title header above each of those pages' own layout.
{%- endcomment -%}
{%- unless page.handle == 'about-us' or page.handle == 'press' or page.handle == 'email-preferences' -%}
  {{ 'pm-page.css' | asset_url | stylesheet_tag }}
  <div class="page-width page-width--narrow page-content">
    {%- render 'breadcrumbs' -%}
    <header class="section-header">
      <h1 class="section-header__title">{{ page.title }}</h1>
    </header>
    <div class="rte rte--nomargin">
      {{ page.content }}
    </div>
  </div>
{%- endunless -%}

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section"
}
{% endschema %}
