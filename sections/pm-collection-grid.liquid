{{ 'pm-homepage.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign family_groups = 'Roma|maxi-roma-0,Santorini|santorini-6,Clutch|clutch-edge-long-silver-blue,Pouch|crystal-pouch,Wallet|crystal-wallet-rare-pink,Capri|capri-bag-gold,Amelia|amelia-bag-gold,Other Bags|mini-milano-n2-sparkle-blue,Accessories|mirage-necklace-green' | split: ','
-%}

<div class="pm-homepage">
  {%- comment -%}
    Category sub-nav — the reference (Gucci) shows a row of bag-type tabs
    under the main nav. Palera's site is organized by family/model line
    rather than bag type, so this reuses the same family list as the Shop
    mega-menu instead of inventing categories with no real collection
    behind them.
  {%- endcomment -%}
  <nav class="pm-plp-subnav">
    <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="pm-plp-subnav-item is-active">View All</a>
    {%- for group in family_groups -%}
      {%- assign group_parts = group | split: '|' -%}
      {%- assign group_name = group_parts[0] -%}
      {%- assign rep_product = all_products[group_parts[1]] -%}
      {%- if rep_product != blank -%}
        <a href="{{ rep_product.url }}" class="pm-plp-subnav-item">{{ group_name }}</a>
      {%- endif -%}
    {%- endfor -%}
  </nav>

  <div class="pm-collection-bar">
    <a href="{{ section.settings.back_url | default: '/collections' }}" class="pm-collection-back">
      ← {{ section.settings.back_label }}
    </a>
    <div class="pm-collection-bar-right">
      <span class="pm-eyebrow">{{ collection.products_count }} {% if collection.products_count == 1 %}piece{% else %}pieces{% endif %}</span>
      {%- if collection.sort_options.size > 0 -%}
        {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
        <div class="pm-collection-sort">
          <label for="PmSortBy" class="pm-visually-hidden">{{ 'collections.sorting.title' | t }}</label>
          <select id="PmSortBy" class="pm-collection-sort-select" data-pm-sort>
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="pm-collection-header">
    {%- if section.settings.line_label != blank -%}<span class="pm-eyebrow">{{ section.settings.line_label }} — Family</span>{%- endif -%}
    <h1 class="pm-serif pm-collection-name">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <p class="pm-serif pm-collection-note">{{ collection.description | strip_html }}</p>
    {%- endif -%}
  </div>

  <div class="pm-collection-grid-wrap">
    {%- if collection.products.size == 0 -%}
      <p class="pm-collection-empty">{{ section.settings.empty_label }}</p>
    {%- else -%}
      {%- comment -%}
        Product tiles are uniform (name + price sit above a plain,
        contained product photo — no gradient caption overlay). A
        campaign placeholder tile (real imagery to be dropped in later)
        breaks the grid every 12 products, always landing on a fresh row
        since 12 is a multiple of both the 2- and 4-column layouts —
        widening to a full-width banner every third break.
      {%- endcomment -%}
      <div class="pm-plp-grid">
        {%- for product in collection.products -%}
          <a href="{{ product.url }}" class="pm-plp-tile pm-reveal" style="transition-delay: {{ forloop.index0 | modulo: 8 | times: 70 }}ms">
            <div class="pm-plp-tile-info">
              <span class="pm-plp-tile-name">{{ product.title }}</span>
              <span class="pm-plp-tile-price">
                {%- if product.price_varies -%}From {{ product.price | money }}{%- else -%}{{ product.price | money }}{%- endif -%}
              </span>
            </div>
            <div class="pm-plp-tile-image">
              {%- if product.featured_image -%}
                <img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | escape | default: product.title }}" loading="lazy">
              {%- else -%}
                {% render 'pm-media-placeholder', label: 'Photo', hover: true %}
              {%- endif -%}
            </div>
          </a>
          {%- unless forloop.last -%}
            {%- assign campaign_check = forloop.index | modulo: 12 -%}
            {%- if campaign_check == 0 -%}
              {%- assign campaign_slot = forloop.index | divided_by: 12 -%}
              {%- assign campaign_slot_check = campaign_slot | modulo: 3 -%}
              {%- assign is_full = false -%}
              {%- if campaign_slot_check == 0 -%}{%- assign is_full = true -%}{%- endif -%}
              <div class="pm-plp-tile pm-plp-campaign-tile{% if is_full %} pm-plp-campaign-tile--full{% endif %}" aria-hidden="true">
                <div class="pm-plp-tile-image pm-plp-tile-image--campaign">
                  {% render 'pm-media-placeholder', label: 'Campaign Photo' %}
                </div>
              </div>
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<script src="{{ 'pm-homepage.js' | asset_url }}" defer></script>
<script>
  (function () {
    var select = document.getElementById('PmSortBy');
    if (!select) return;
    select.addEventListener('change', function () {
      var url = new URL(window.location.href);
      url.searchParams.set('sort_by', select.value);
      window.location.href = url.toString();
    });
  })();
</script>

{% schema %}
{
  "name": "PM: Collection grid",
  "settings": [
    { "type": "text", "id": "back_label", "label": "Back link label", "default": "All Families" },
    { "type": "url", "id": "back_url", "label": "Back link URL", "info": "Point this at your Shop by Family page (/collections)." },
    { "type": "text", "id": "line_label", "label": "Line label override" },
    { "type": "text", "id": "empty_label", "label": "Empty collection message", "default": "New pieces for this family are on the way." }
  ]
}
{% endschema %}
