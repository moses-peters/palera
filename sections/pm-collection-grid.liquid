{{ 'pm-homepage.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  pm-family-data is rendered, not included — some shops reject
  the include tag outright ("Include usage is not allowed in this
  context"). {% render %} runs in an isolated scope, so it can't
  assign into this template directly; capture its text output instead
  and split it here.
{%- endcomment -%}
{%- capture pm_families_raw -%}{% render 'pm-family-data' %}{%- endcapture -%}
{%- assign pm_families = pm_families_raw | strip | split: ';;' -%}

{%- comment -%}
  Every bag is one Shopify product with a Color option holding several
  variants, not separate per-color products — Shopify has no setting
  that renders one Product as multiple collection-grid tiles (Combined
  Listings runs the opposite direction: merging separate products into
  one PDP). So the grid below explodes each product into one tile per
  color itself. Pre-count how many tiles that actually produces, so the
  piece count and the "don't break mid-product" campaign-tile logic
  further down both use the real tile count instead of the product
  count.
{%- endcomment -%}
{%- assign total_tile_count = 0 -%}
{%- for product in collection.products -%}
  {%- assign color_option = nil -%}
  {%- for option in product.options_with_values -%}
    {%- assign option_name_downcase = option.name | downcase -%}
    {%- if option_name_downcase == 'color' or option_name_downcase == 'colour' -%}
      {%- assign color_option = option -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if color_option -%}
    {%- assign total_tile_count = total_tile_count | plus: color_option.values.size -%}
  {%- else -%}
    {%- assign total_tile_count = total_tile_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

<div class="pm-homepage">
  {%- comment -%}
    Category sub-nav — the reference (Gucci) shows a row of bag-type tabs
    under the main nav. Palera's site is organized by family/model line
    rather than bag type, so this reuses the same family list as the Shop
    mega-menu (pm-family-data) instead of inventing categories with no
    real collection behind them. Each tab is a real link to this same
    page with ?family=... — clicking one is a normal page navigation,
    not an in-place filter. There's no real per-family Shopify
    Collection to filter server-side (Shopify caches rendered HTML by
    URL, so query-string-driven server content isn't safe to rely on —
    a cached response could show one visitor a family meant for another),
    so the page that loads still sorts itself out client-side once on
    arrival (see data-family on each tile, and the script at the
    bottom) rather than as a live, click-driven filter.
  {%- endcomment -%}
  <nav class="pm-plp-subnav" data-pm-family-nav>
    <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="pm-plp-subnav-item is-active" data-family-filter="">View All</a>
    {%- for family in pm_families -%}
      {%- assign family_parts = family | split: '|' -%}
      {%- assign family_name = family_parts[0] -%}
      {%- assign family_handle = family_name | handle -%}
      <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}?family={{ family_handle }}" class="pm-plp-subnav-item" data-family-filter="{{ family_handle }}">{{ family_name }}</a>
    {%- endfor -%}
  </nav>

  <div class="pm-collection-bar">
    <a href="{{ section.settings.back_url | default: '/collections' }}" class="pm-collection-back">
      ← {{ section.settings.back_label }}
    </a>
    <div class="pm-collection-bar-right">
      <span class="pm-eyebrow" data-pm-piece-count>{{ total_tile_count }} {% if total_tile_count == 1 %}piece{% else %}pieces{% endif %}</span>
      {%- if collection.sort_options.size > 0 -%}
        {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
        <div class="pm-collection-sort">
          <label for="PmSortBy" class="pm-visually-hidden">{{ 'collections.sorting.title' | t }}</label>
          <select id="PmSortBy" class="pm-collection-sort-select" data-pm-sort>
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="pm-collection-header">
    {%- if section.settings.line_label != blank -%}<span class="pm-eyebrow">{{ section.settings.line_label }} — Family</span>{%- endif -%}
    <h1 class="pm-serif pm-collection-name" data-pm-collection-title>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <p class="pm-serif pm-collection-note">{{ collection.description | strip_html }}</p>
    {%- endif -%}
  </div>

  <div class="pm-collection-grid-wrap">
    {%- if collection.products.size == 0 -%}
      <p class="pm-collection-empty">{{ section.settings.empty_label }}</p>
    {%- else -%}
      {%- comment -%}
        Product tiles are uniform (name + price sit above a plain,
        contained product photo — no gradient caption overlay), one per
        color (see the pre-count above). A campaign placeholder tile
        (real imagery to be dropped in later) breaks the grid every 12
        tiles, always landing on a fresh row since 12 is a multiple of
        both the 2- and 4-column layouts — widening to a full-width
        banner every third break.
      {%- endcomment -%}
      <div class="pm-plp-grid" data-pm-plp-grid>
        {%- assign editorial_break_index = -1 -%}
        {%- assign tile_index = 0 -%}
        {%- for product in collection.products -%}
          {%- comment -%}
            No real per-family Collection exists to filter against, so
            sort each product into one of the 9 real families by matching
            keywords (pm-family-data) against its title. Products that
            don't match any keyword still show under View All, just not
            under any family tab.
          {%- endcomment -%}
          {%- assign tile_family = '' -%}
          {%- assign title_downcase = product.title | downcase -%}
          {%- for family in pm_families -%}
            {%- if tile_family == '' -%}
              {%- assign family_parts = family | split: '|' -%}
              {%- assign family_name = family_parts[0] -%}
              {%- assign family_keywords = family_parts[2] | split: ',' -%}
              {%- for keyword in family_keywords -%}
                {%- assign keyword_downcase = keyword | downcase -%}
                {%- if tile_family == '' and title_downcase contains keyword_downcase -%}
                  {%- assign tile_family = family_name | handle -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}

          {%- comment -%}
            Each bag is one product with a Color option holding several
            variants — split it into one tile per color (see the
            pre-count comment above the piece-count computation).
            Products with no Color option just render their one tile,
            same as before.
          {%- endcomment -%}
          {%- assign color_option = nil -%}
          {%- for option in product.options_with_values -%}
            {%- assign option_name_downcase = option.name | downcase -%}
            {%- if option_name_downcase == 'color' or option_name_downcase == 'colour' -%}
              {%- assign color_option = option -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if color_option -%}
            {%- assign color_values = color_option.values -%}
            {%- assign color_option_key = 'option' | append: color_option.position -%}
          {%- else -%}
            {%- assign color_values = 'x' | split: ',' -%}
          {%- endif -%}

          {%- for color_value in color_values -%}
            {%- assign tile_index = tile_index | plus: 1 -%}
            {%- comment -%}
              tile_name is always the plain product title — no color
              suffix. Each color still gets its own tile (data-family,
              image, price, and the ?variant= link all still come from
              that specific color's variant), the name just doesn't
              spell the color out.
            {%- endcomment -%}
            {%- assign tile_name = product.title -%}
            {%- if color_option -%}
              {%- assign tile_variant = product.variants | where: color_option_key, color_value | first -%}
              {%- assign tile_price_varies = false -%}
            {%- else -%}
              {%- assign tile_variant = product.selected_or_first_available_variant -%}
              {%- assign tile_price_varies = product.price_varies -%}
            {%- endif -%}
            {%- assign tile_image = tile_variant.featured_image | default: product.featured_image -%}
            {%- assign tile_price = tile_variant.price | default: product.price -%}

            <a href="{{ product.url }}{% if tile_variant %}?variant={{ tile_variant.id }}{% endif %}" class="pm-plp-tile pm-reveal" data-family="{{ tile_family }}" style="transition-delay: {{ tile_index | modulo: 8 | times: 70 }}ms">
              <div class="pm-plp-tile-image">
                {%- if tile_image -%}
                  <img src="{{ tile_image | image_url: width: 900 }}" alt="{{ tile_image.alt | escape | default: tile_name }}" loading="lazy">
                {%- else -%}
                  {% render 'pm-media-placeholder', label: 'Photo', hover: true %}
                {%- endif -%}
              </div>
              <div class="pm-plp-tile-info">
                <span class="pm-plp-tile-name">{{ tile_name }}</span>
                <span class="pm-plp-tile-price">
                  {%- if tile_price_varies -%}From {{ tile_price | money }}{%- else -%}{{ tile_price | money }}{%- endif -%}
                </span>
              </div>
            </a>
          {%- unless tile_index == total_tile_count -%}
            {%- assign campaign_check = tile_index | modulo: 12 -%}
            {%- if campaign_check == 0 -%}
              {%- comment -%}
                Editorial breaks pull from this section's "Editorial
                break" blocks in order (image or video, plus a caption) —
                these are the "handles" a merchant fills in via the
                theme editor for real campaign photos/video, one per
                break as the grid scrolls. Any break beyond the blocks
                defined here falls back to the plain placeholder tile.
              {%- endcomment -%}
              {%- assign editorial_break_index = editorial_break_index | plus: 1 -%}
              {%- assign editorial_block = section.blocks[editorial_break_index] -%}
              {%- assign campaign_slot = tile_index | divided_by: 12 -%}
              {%- assign campaign_slot_check = campaign_slot | modulo: 3 -%}
              {%- assign is_full = false -%}
              {%- if campaign_slot_check == 0 -%}{%- assign is_full = true -%}{%- endif -%}
              {%- if editorial_block.settings.full_width -%}{%- assign is_full = true -%}{%- endif -%}
              <div class="pm-plp-tile pm-plp-campaign-tile{% if is_full %} pm-plp-campaign-tile--full{% endif %}" aria-hidden="true"{% if editorial_block %} {{ editorial_block.shopify_attributes }}{% endif %}>
                <div class="pm-plp-tile-image pm-plp-tile-image--campaign">
                  {%- if editorial_block.settings.video_url != blank -%}
                    <video autoplay muted loop playsinline{% if editorial_block.settings.image %} poster="{{ editorial_block.settings.image | image_url: width: 1800 }}"{% endif %}>
                      <source src="{{ editorial_block.settings.video_url }}" type="video/mp4">
                    </video>
                  {%- elsif editorial_block.settings.image -%}
                    <img src="{{ editorial_block.settings.image | image_url: width: 1800 }}" alt="{{ editorial_block.settings.image.alt | escape | default: editorial_block.settings.caption }}" loading="lazy">
                  {%- else -%}
                    {% render 'pm-media-placeholder', label: 'Campaign Photo' %}
                  {%- endif -%}
                </div>
                {%- if editorial_block.settings.caption != blank -%}
                  <p class="pm-eyebrow pm-plp-campaign-caption">{{ editorial_block.settings.caption }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endunless -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<script src="{{ 'pm-homepage.js' | asset_url }}" defer></script>
<script>
  (function () {
    var select = document.getElementById('PmSortBy');
    if (select) {
      select.addEventListener('change', function () {
        var url = new URL(window.location.href);
        url.searchParams.set('sort_by', select.value);
        window.location.href = url.toString();
      });
    }

    var grid = document.querySelector('[data-pm-plp-grid]');
    var nav = document.querySelector('[data-pm-family-nav]');
    if (!grid || !nav) return;

    var countEl = document.querySelector('[data-pm-piece-count]');
    var titleEl = document.querySelector('[data-pm-collection-title]');
    var baseTitle = titleEl ? titleEl.textContent : '';

    var tiles = Array.prototype.slice.call(grid.querySelectorAll('.pm-plp-tile:not(.pm-plp-campaign-tile)'));
    var campaignTiles = Array.prototype.slice.call(grid.querySelectorAll('.pm-plp-campaign-tile'));
    var originalOrder = tiles.slice();

    // A freestyle (shuffled) order per filter, so a family tab doesn't
    // show the same fixed sequence every time — only applied within a
    // family filter; View All keeps the section's real product order.
    function shuffled(list) {
      var copy = list.slice();
      for (var i = copy.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var tmp = copy[i]; copy[i] = copy[j]; copy[j] = tmp;
      }
      return copy;
    }

    function applyFilter(familyHandle, familyLabel) {
      var isFiltered = !!familyHandle;
      campaignTiles.forEach(function (tile) { tile.classList.toggle('pm-is-hidden', isFiltered); });

      var visible;
      if (!isFiltered) {
        visible = originalOrder;
        tiles.forEach(function (tile) { tile.classList.remove('pm-is-hidden'); });
      } else {
        visible = shuffled(tiles.filter(function (tile) { return tile.getAttribute('data-family') === familyHandle; }));
        tiles.forEach(function (tile) { tile.classList.toggle('pm-is-hidden', tile.getAttribute('data-family') !== familyHandle); });
      }
      visible.forEach(function (tile) { grid.appendChild(tile); });

      nav.querySelectorAll('[data-family-filter]').forEach(function (link) {
        link.classList.toggle('is-active', link.getAttribute('data-family-filter') === familyHandle);
      });
      if (countEl) {
        countEl.textContent = visible.length + ' ' + (visible.length === 1 ? 'piece' : 'pieces');
      }
      if (titleEl) {
        titleEl.textContent = isFiltered ? familyLabel : baseTitle;
      }
    }

    {%- comment -%}
      Family links (here and in the mega-menu/mobile drawer) are real
      <a href> navigations to this same page with ?family=... — clicking
      one is a full page load, not an in-place filter swap, so it reads
      as going to that family's page. There's still no real per-family
      Shopify Collection behind it, so the arriving page still needs to
      sort itself out client-side once — that's all this does now: read
      the family off the URL on load and apply it, with no click
      handling or history.pushState left to fight the browser's own
      navigation.
    {%- endcomment -%}
    var initialFamily = new URLSearchParams(window.location.search).get('family');
    if (initialFamily) {
      var initialLink = nav.querySelector('[data-family-filter="' + initialFamily + '"]');
      if (initialLink) applyFilter(initialFamily, initialLink.textContent.trim());
    }
  })();
</script>

{% schema %}
{
  "name": "PM: Collection grid",
  "settings": [
    { "type": "text", "id": "back_label", "label": "Back link label", "default": "All Families" },
    { "type": "url", "id": "back_url", "label": "Back link URL", "info": "Point this at your Shop by Family page (/collections)." },
    { "type": "text", "id": "line_label", "label": "Line label override" },
    { "type": "text", "id": "empty_label", "label": "Empty collection message", "default": "New pieces for this family are on the way." }
  ],
  "blocks": [
    {
      "type": "editorial_break",
      "name": "Editorial break",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "video_url", "label": "Video URL (.mp4)", "info": "Overrides the image when set." },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false }
      ]
    }
  ]
}
{% endschema %}
