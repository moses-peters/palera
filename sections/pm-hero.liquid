{{ 'pm-homepage.css' | asset_url | stylesheet_tag }}

<div class="pm-homepage">
  <section class="pm-hero">
    <div class="pm-hero-media">
      {%- if section.settings.video_url != blank -%}
        <video autoplay muted loop playsinline poster="{% if section.settings.image %}{{ section.settings.image | image_url: width: 1800 }}{% endif %}">
          <source src="{{ section.settings.video_url }}" type="video/mp4">
        </video>
      {%- elsif section.settings.image -%}
        <img src="{{ section.settings.image | image_url: width: 1800 }}" alt="{{ shop.name }}" loading="eager">
      {%- else -%}
        <img src="{{ 'pm-drive-hero.jpg' | asset_url }}" alt="{{ shop.name }}" loading="eager">
      {%- endif -%}
    </div>
  </section>
</div>

<script src="{{ 'pm-homepage.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "PM: Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "video_url", "label": "Video URL (.mp4)", "info": "Overrides the image when set." }
  ],
  "presets": [{ "name": "PM: Hero" }]
}
{% endschema %}
