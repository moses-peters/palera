{{ 'pm-homepage.css' | asset_url | stylesheet_tag }}

<div class="pm-homepage">
  <section class="pm-hero">
    <div class="pm-hero-media">
      {%- if section.settings.video_url != blank -%}
        <video autoplay muted loop playsinline poster="{% if section.settings.image %}{{ section.settings.image | image_url: width: 1800 }}{% endif %}">
          <source src="{{ section.settings.video_url }}" type="video/mp4">
        </video>
      {%- elsif section.settings.image -%}
        <img src="{{ section.settings.image | image_url: width: 1800 }}" alt="{{ section.settings.image.alt | escape | default: section.settings.heading }}" loading="eager">
      {%- else -%}
        {% render 'pm-media-placeholder', label: 'Hero Video' %}
      {%- endif -%}
    </div>

    {%- if section.settings.eyebrow != blank -%}
      <span class="pm-hero-eyebrow pm-eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}

    <h1 class="pm-hero-heading pm-serif">{{ section.settings.heading | newline_to_br }}</h1>

    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="pm-hero-cta pm-link">{{ section.settings.button_label }}</a>
    {%- endif -%}

    {%- if section.settings.scroll_cue_text != blank -%}
      <span class="pm-hero-scroll-cue">{{ section.settings.scroll_cue_text }}</span>
    {%- endif -%}
  </section>
</div>

<script src="{{ 'pm-homepage.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "PM: Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "SS26 — Riviera" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Light,\ncaught in\ncrystal" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Discover the Collection" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "scroll_cue_text", "label": "Scroll cue text", "default": "Scroll" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "video_url", "label": "Video URL (.mp4)", "info": "Overrides the image when set." }
  ],
  "presets": [{ "name": "PM: Hero" }]
}
{% endschema %}
