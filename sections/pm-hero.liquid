{{ 'pm-homepage.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  This section is reused across pages with different photos (homepage,
  AW27 banner), so the crop focal point is a per-instance setting rather
  than a fixed CSS rule — each instance can frame its own image
  differently instead of all sharing one center-crop.
{%- endcomment -%}
{%- liquid
  assign focal_x = section.settings.focal_x | default: 50
  assign focal_y = section.settings.focal_y | default: 50
-%}
<div class="pm-homepage">
  <section class="pm-hero">
    <a href="{{ section.settings.link_url | default: '#' }}" class="pm-hero-media" style="--pm-focal: {{ focal_x }}% {{ focal_y }}%;">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '1800x' }}
      {%- elsif section.settings.image -%}
        <img src="{{ section.settings.image | image_url: width: 1800 }}" alt="{{ shop.name }}" loading="eager">
      {%- else -%}
        <img src="{{ 'pm-drive-hero.jpg' | asset_url }}" alt="{{ shop.name }}" loading="eager">
      {%- endif -%}
    </a>
  </section>
</div>

<script src="{{ 'pm-homepage.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "PM: Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "video", "id": "video", "label": "Video", "info": "Uploaded directly (not a pasted link) — overrides the image when set." },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "range", "id": "focal_x", "label": "Focal point — horizontal", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50, "info": "Lower = crop shows more of the image's left side." },
    { "type": "range", "id": "focal_y", "label": "Focal point — vertical", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50, "info": "Lower = crop shows more of the image's top." }
  ],
  "presets": [{ "name": "PM: Hero" }]
}
{% endschema %}
