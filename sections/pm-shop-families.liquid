{{ 'pm-homepage.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Shop-by-Family landing page — one view, click a family to reveal its
  pieces in place (no page navigation). Families are grouped the same
  way as the header's Shop mega-menu (see pm-shop-menu.liquid) so the
  two stay consistent: name|representative_handle|member_handle:Label,...
{%- endcomment -%}
{%- liquid
  assign family_groups = 'Roma|maxi-roma-0|diamond-maxi-roma-lock:Diamond Maxi Roma Lock,diamond-roma-belt-u:Diamond Roma Belt-U,maxi-roma-0:Maxi Roma,maxi-roma-lock:Maxi Roma-Lock,diamond-maxi-roma-1:Diamond Maxi Roma,diamond-mini-roma-1:Diamond Mini Roma,mini-roma-1:Mini Roma,roma-belt-u-black:Roma Belt-U,mini-roma-exclusive-uae:Mini Roma - UAE;Santorini|santorini-6|santorini-6:Santorini,santorini-lock-green:Santorini-Lock,diamond-santorini-1:Diamond Santorini;Clutch|clutch-edge-long-silver-blue|clutch-edge-long-silver-blue:Clutch Edge-Long,clutch-edge-short-copy:Clutch Edge - Short,clutch-edge-airpod-wood-crystal:Clutch Edge - Airpod - Wood - Crystal,clutch-edge-airpod:Clutch Edge - Airpod,clutch-edge-short-brass-champagne:Clutch Edge - Short - Brass - Crystal,clutch-mini-champagne:Clutch Mini Bag,clutch-mini-brass-silve-blue:Clutch Mini - Brass - Crystal,clutch-mini-wood-crystal-silver-blue:Clutch Mini Wood - Crystal,clutch-wood-crystal-sylver-blue:Clutch Wood-Crystal,clutch-micro-bag:Clutch Micro Bag;Pouch|crystal-pouch|crystal-pouch:Crystal Pouch,crystal-pouch-wood-1:Crystal Pouch - Wood,crystal-pouch-brass-rare-pink:Crystal Pouch - Brass,maxi-crystal-wood-pouch-rare-pink:Maxi Crystal Wood - Pouch;Wallet|crystal-wallet-rare-pink|crystal-wallet-rare-pink:Crystal Wallet,crystal-wallet-wood-rare-pink:Crystal Wallet - Wood,wallet-chain-rare-pink:Wallet Chain;Capri|capri-bag-gold|capri-bag-gold:Capri Bag,capri-baby-brown:Capri Baby,capri-baby-wood-silver-blue:Capri Baby Wood;Amelia|amelia-bag-gold|amelia-bag-gold:Amelia Bag,amelia-brass-silver-blue:Amelia Brass - Crystal,amelia-wood-crystal-green:Amelia Wood-Crystal;Other Bags|mini-milano-n2-sparkle-blue|mini-milano-n2-sparkle-blue:Mini Milano N2,diamond-mini-milano-n2-22:Diamond Mini Milano N2,hobo-wood-bag:Wood Net Hobo;Accessories|mirage-necklace-green|mirage-necklace-green:Mirage Necklace,mirage-necklace-crystal:Mirage Necklace-Crystal,mirage-multi-necklaces:Mirage Multi-Necklace,necklace-agate-purple:Necklace Agate,necklace-agate-heart-purple:Necklace Agate Heart,necklace-crystal-heart-rare-pink:Necklace Crystal Heart,necklace-crystal-silver-blue:Necklace Crystal,belt:Belt' | split: ';'
-%}

<div class="pm-homepage">
  <section class="pm-shop-intro pm-reveal">
    {%- if section.settings.eyebrow != blank -%}<span class="pm-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h1 class="pm-serif">{{ section.settings.heading }}</h1>
    {%- if section.settings.subheading != blank -%}<p class="pm-serif">{{ section.settings.subheading }}</p>{%- endif -%}
  </section>

  <div class="pm-shop-wrap">
    <div class="pm-family-grid" data-family-grid>
      {%- for group in family_groups -%}
        {%- assign group_parts = group | split: '|' -%}
        {%- assign group_name = group_parts[0] -%}
        {%- assign group_slug = group_name | handle -%}
        {%- assign rep_product = all_products[group_parts[1]] -%}
        {%- assign members = group_parts[2] | split: ',' -%}
        {%- assign pos = forloop.index0 | modulo: 15 -%}
        {%- assign is_big = false -%}
        {%- if pos == 0 or pos == 13 or pos == 14 -%}{%- assign is_big = true -%}{%- endif -%}
        <button
          type="button"
          class="pm-family-tile pm-reveal{% if is_big %} pm-family-tile--big{% endif %}"
          style="transition-delay: {{ forloop.index0 | modulo: 8 | times: 70 }}ms"
          data-family-trigger
          data-family="{{ group_slug }}"
          aria-expanded="false"
          aria-controls="FamilyPanel-{{ group_slug }}"
        >
          {%- if rep_product.featured_image -%}
            <img class="pm-family-tile-image" src="{{ rep_product.featured_image | image_url: width: 900 }}" alt="{{ group_name }}" loading="lazy">
          {%- else -%}
            {% render 'pm-media-placeholder', label: group_name, hover: true %}
          {%- endif -%}
          <div class="pm-family-tile-caption">
            <span class="pm-serif pm-family-tile-name">{{ group_name }}</span>
            {%- if is_big -%}
              <span class="pm-family-tile-count">{{ members.size }} {% if members.size == 1 %}piece{% else %}pieces{% endif %}</span>
            {%- endif -%}
          </div>
        </button>
      {%- endfor -%}
    </div>

    {%- for group in family_groups -%}
      {%- assign group_parts = group | split: '|' -%}
      {%- assign group_name = group_parts[0] -%}
      {%- assign group_slug = group_name | handle -%}
      {%- assign members = group_parts[2] | split: ',' -%}
      <div class="pm-family-panel" id="FamilyPanel-{{ group_slug }}" data-family-panel="{{ group_slug }}" hidden>
        <div class="pm-family-panel-head">
          <span class="pm-serif pm-family-panel-name">{{ group_name }}</span>
          <button type="button" class="pm-family-panel-close" data-family-close aria-label="Close">Close ✕</button>
        </div>
        <div class="pm-collection-grid">
          {%- for member in members -%}
            {%- assign member_parts = member | split: ':' -%}
            {%- assign member_product = all_products[member_parts[0]] -%}
            {%- if member_product != blank -%}
              <a href="{{ member_product.url }}" class="pm-product-tile">
                {%- if member_product.featured_image -%}
                  <img class="pm-product-image" src="{{ member_product.featured_image | image_url: width: 900 }}" alt="{{ member_product.featured_image.alt | escape | default: member_parts[1] }}" loading="lazy">
                {%- else -%}
                  {% render 'pm-media-placeholder', label: 'Photo', hover: true %}
                {%- endif -%}
                <div class="pm-product-caption">
                  <span class="pm-product-title">{{ member_parts[1] }}</span>
                  <span class="pm-product-price">
                    {%- if member_product.price_varies -%}From {{ member_product.price | money }}{%- else -%}{{ member_product.price | money }}{%- endif -%}
                  </span>
                </div>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

<script src="{{ 'pm-homepage.js' | asset_url }}" defer></script>
<script>
  (function () {
    document.addEventListener('click', function (e) {
      var trigger = e.target.closest('[data-family-trigger]');
      var closeBtn = e.target.closest('[data-family-close]');
      if (!trigger && !closeBtn) return;

      var grid = e.target.closest('[data-family-grid]') || document.querySelector('[data-family-grid]');
      var wrap = grid ? grid.parentElement : document;
      var panels = wrap.querySelectorAll('[data-family-panel]');
      var triggers = wrap.querySelectorAll('[data-family-trigger]');

      if (closeBtn) {
        var openPanel = closeBtn.closest('[data-family-panel]');
        openPanel.hidden = true;
        triggers.forEach(function (t) { t.setAttribute('aria-expanded', 'false'); });
        return;
      }

      var family = trigger.getAttribute('data-family');
      var target = wrap.querySelector('[data-family-panel="' + family + '"]');
      var alreadyOpen = target && !target.hidden;

      panels.forEach(function (p) { p.hidden = true; });
      triggers.forEach(function (t) { t.setAttribute('aria-expanded', 'false'); });

      if (target && !alreadyOpen) {
        target.hidden = false;
        trigger.setAttribute('aria-expanded', 'true');
        target.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
  })();
</script>

{% schema %}
{
  "name": "PM: Shop families",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Family" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Choose a family, then the piece within it." }
  ]
}
{% endschema %}
