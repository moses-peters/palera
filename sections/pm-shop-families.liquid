{{ 'pm-homepage.css' | asset_url | stylesheet_tag }}

<div class="pm-homepage">
  <section class="pm-shop-intro pm-reveal">
    {%- if section.settings.eyebrow != blank -%}<span class="pm-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h1 class="pm-serif">{{ section.settings.heading }}</h1>
    {%- if section.settings.subheading != blank -%}<p class="pm-serif">{{ section.settings.subheading }}</p>{%- endif -%}
  </section>

  <div class="pm-shop-wrap">
    <div class="pm-family-grid">
      {%- for block in section.blocks -%}
        {%- assign col = block.settings.collection -%}
        {%- assign tile_image = block.settings.image | default: col.featured_image -%}
        {%- assign tile_label = col.title | default: block.settings.fallback_label -%}
        {%- assign tile_url = col.url | default: block.settings.fallback_url -%}
        <a
          href="{{ tile_url | default: '#' }}"
          class="pm-family-tile pm-reveal"
          style="transition-delay: {{ forloop.index0 | modulo: 4 | times: 80 }}ms"
          {{ block.shopify_attributes }}
        >
          <div class="pm-family-tile-media">
            {%- if tile_image -%}
              <img src="{{ tile_image | image_url: width: 900 }}" alt="{{ tile_image.alt | escape | default: tile_label }}" loading="lazy">
            {%- else -%}
              {% render 'pm-media-placeholder', label: 'Family', hover: true %}
            {%- endif -%}
            {%- if block.settings.line_label != blank -%}<span class="pm-family-tile-line">{{ block.settings.line_label }}</span>{%- endif -%}
          </div>
          <div class="pm-family-tile-info">
            <span class="pm-serif pm-family-tile-name">{{ tile_label }}</span>
            <span class="pm-family-tile-count">
              {%- if col -%}{{ col.products_count }} {% if col.products_count == 1 %}piece{% else %}pieces{% endif %}{%- else -%}Coming soon{%- endif -%}
            </span>
          </div>
          <span class="pm-link pm-family-tile-enter">Enter the Family</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

<script src="{{ 'pm-homepage.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "PM: Shop families",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Family" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Choose a family, then the piece within it." }
  ],
  "blocks": [
    {
      "type": "family",
      "name": "Family",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Once you create this collection in Shopify, its title, image and product count take over automatically." },
        { "type": "text", "id": "fallback_label", "label": "Name (used until a collection is assigned)" },
        { "type": "text", "id": "line_label", "label": "Line tag (e.g. Roma, Santorini, Pouch, Clutch)" },
        { "type": "image_picker", "id": "image", "label": "Image (used until a collection is assigned)" },
        { "type": "url", "id": "fallback_url", "label": "Link (used until a collection is assigned)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PM: Shop families",
      "blocks": [
        { "type": "family", "settings": { "fallback_label": "Diamond Maxi Roma", "line_label": "Roma" } },
        { "type": "family", "settings": { "fallback_label": "Diamond Mini Roma", "line_label": "Roma" } },
        { "type": "family", "settings": { "fallback_label": "Mini Roma", "line_label": "Roma" } },
        { "type": "family", "settings": { "fallback_label": "Maxi Roma", "line_label": "Roma" } },
        { "type": "family", "settings": { "fallback_label": "Crystal Pouch", "line_label": "Pouch" } },
        { "type": "family", "settings": { "fallback_label": "Crystal Pouch Long", "line_label": "Pouch" } },
        { "type": "family", "settings": { "collection": "santorini", "fallback_label": "Santorini", "line_label": "Santorini" } },
        { "type": "family", "settings": { "fallback_label": "Diamond Santorini", "line_label": "Santorini" } },
        { "type": "family", "settings": { "fallback_label": "Clutch Edge Long", "line_label": "Clutch" } },
        { "type": "family", "settings": { "fallback_label": "Jewelry & Accessories", "line_label": "Accessories" } }
      ]
    }
  ]
}
{% endschema %}
