{{ 'pm-homepage.css' | asset_url | stylesheet_tag }}

<div class="pm-homepage">
  <footer class="pm-footer">
    <div class="pm-footer-top">
      <div class="pm-footer-brand">
        <span class="pm-serif pm-footer-wordmark">{{ shop.name }}</span>
        {%- if section.settings.tagline != blank -%}
          <p class="pm-footer-tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}
      </div>
      <div class="pm-footer-cols">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'menu' -%}
              {%- assign menu = linklists[block.settings.menu] -%}
              {%- if menu.links.size > 0 -%}
                <div class="pm-footer-col" {{ block.shopify_attributes }}>
                  <h4>{{ block.settings.title | default: menu.title }}</h4>
                  <ul>
                    {%- for link in menu.links -%}
                      <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.show_newsletter -%}
      <div class="pm-footer-newsletter-compact pm-reveal">
        {%- if section.settings.newsletter_eyebrow != blank -%}<span class="pm-eyebrow">{{ section.settings.newsletter_eyebrow }}</span>{%- endif -%}
        <span class="pm-footer-newsletter-compact-heading">{{ section.settings.newsletter_heading }}</span>

        <form class="pm-footer-newsletter-form pm-footer-newsletter-form--compact" data-klaviyo-signup-form data-klaviyo-list-id="{{ section.settings.klaviyo_list_id }}">
          <label for="FooterNewsletterEmail-{{ section.id }}" class="pm-visually-hidden">Email address</label>
          <input
            id="FooterNewsletterEmail-{{ section.id }}"
            type="email"
            name="email"
            class="pm-footer-newsletter-input pm-serif"
            placeholder="Your email address"
            required
          >
          <button type="submit" class="pm-footer-newsletter-submit">Subscribe</button>
          <p class="pm-footer-newsletter-message" data-klaviyo-signup-message hidden></p>
        </form>
      </div>
    {%- endif -%}

    <div class="pm-footer-bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      {%- comment -%}
        Hardcoded rather than a linklist entry — adding a real item to a
        Shopify navigation menu needs Admin access this theme doesn't
        have; a direct link avoids depending on a menu being set up.
      {%- endcomment -%}
      <a href="/pages/press">Press</a>
      {%- if settings.social_instagram_link != blank or settings.social_pinterest_link != blank or settings.social_tiktok_link != blank or settings.social_youtube_link != blank or settings.social_facebook_link != blank -%}
        <span class="pm-footer-socials">
          {%- if settings.social_instagram_link != blank -%}<a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
          {%- if settings.social_pinterest_link != blank -%}<a href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener">Pinterest</a>{%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}<a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener">TikTok</a>{%- endif -%}
          {%- if settings.social_youtube_link != blank -%}<a href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener">YouTube</a>{%- endif -%}
          {%- if settings.social_facebook_link != blank -%}<a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener">Facebook</a>{%- endif -%}
        </span>
      {%- endif -%}
      <span>{{ section.settings.location_text }}</span>
    </div>
  </footer>
</div>

<script src="{{ 'pm-homepage.js' | asset_url }}" defer></script>
<script src="{{ 'pm-klaviyo-signup.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "PM: Footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Brand tagline", "default": "Hand-set crystal, made in Italy." },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter signup", "default": true },
    { "type": "text", "id": "newsletter_eyebrow", "label": "Newsletter eyebrow" },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Join the Palera Community" },
    { "type": "text", "id": "newsletter_text", "label": "Newsletter text", "default": "Subscribe and enjoy 10% off your first order." },
    {
      "type": "text",
      "id": "klaviyo_list_id",
      "label": "Klaviyo list ID",
      "default": "YrD2Vj",
      "info": "Defaults to the \"Newsletter\" list created for this signup form."
    },
    { "type": "text", "id": "location_text", "label": "Location text", "default": "Milano, Italia" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "link_list", "id": "menu", "label": "Menu" },
        { "type": "text", "id": "title", "label": "Column title override", "info": "Defaults to the menu's own title" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "menu": "client-service" } },
      { "type": "menu", "settings": { "menu": "footer" } },
      { "type": "menu", "settings": { "menu": "contact-us" } }
    ]
  }
}
{% endschema %}
