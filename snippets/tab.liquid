{%- comment -%}
  Plain text trigger + slide-in drawer (shared .pm-drawer shell, see
  pm-product.css/pm-product.js) instead of an inline-expanding
  accordion -- same pattern as the "see all colors" swatch picker.
{%- endcomment -%}
{%- liquid
  assign output_tab = true
  if title == blank and content == blank
    assign output_tab = false
  endif
-%}
{%- if output_tab -%}
  <button type="button" class="pm-info-trigger" data-pm-drawer-open="pm-info-drawer-{{ id }}">{{ title }}</button>
  <div class="pm-drawer" data-pm-drawer id="pm-info-drawer-{{ id }}" hidden>
    <div class="pm-drawer__overlay" data-pm-drawer-close></div>
    <div class="pm-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ title | strip_html | escape }}">
      <div class="pm-drawer__header">
        <span class="pm-drawer__title">{{ title }}</span>
        <button type="button" class="pm-drawer__close" data-pm-drawer-close aria-label="Close">&times;</button>
      </div>
      <div class="pm-drawer__body collapsible-content__inner rte">
        {{ content }}
      </div>
    </div>
  </div>
{%- endif -%}
