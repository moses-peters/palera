{%- comment -%}
  Loads the font pairing chosen in Theme settings > PM: Typography and
  sets --pm-font-serif / --pm-font-sans, which every custom "pm-" page
  (homepage, Shop, About, Press, product) reads from. These are real
  Google Fonts (free, no purchase), loaded here directly rather than
  through Shopify's font_picker + font_face (see snippets/font-face.liquid
  for that separate, stock-theme font system) since a font_picker only
  offers Shopify's own hosted library, not arbitrary Google fonts.
{%- endcomment -%}
{%- liquid
  assign pairing = settings.pm_font_pairing | default: 'cormorant_inter'
  assign needs_google_fonts = true
  case pairing
    when 'helvetica'
      # Helvetica Neue ships on macOS/iOS; Arial is a near-identical
      # metric-compatible fallback everywhere else, so no webfont file
      # is needed at all -- same stack for both heading and body
      # (no serif in this pairing).
      assign needs_google_fonts = false
      assign serif_stack = "'Helvetica Neue', Helvetica, Arial, sans-serif"
      assign sans_stack = "'Helvetica Neue', Helvetica, Arial, sans-serif"
    when 'playfair_jost'
      # Served from the theme's own files (Latin subset, same files Google
      # Fonts serves) instead of fonts.googleapis.com: no render-blocking
      # request to another domain, and the files are preloaded.
      assign needs_google_fonts = false
      assign self_hosted = 'playfair_jost'
      assign serif_stack = "'Playfair Display', ui-serif, Georgia, serif"
      assign sans_stack = "'Jost', ui-sans-serif, system-ui, sans-serif"
    when 'garamond_work'
      assign google_families = 'EB+Garamond:wght@400;500;600&family=Work+Sans:wght@400;500'
      assign serif_stack = "'EB Garamond', ui-serif, Georgia, serif"
      assign sans_stack = "'Work Sans', ui-sans-serif, system-ui, sans-serif"
    when 'fraunces_karla'
      assign google_families = 'Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Karla:wght@400;500'
      assign serif_stack = "'Fraunces', ui-serif, Georgia, serif"
      assign sans_stack = "'Karla', ui-sans-serif, system-ui, sans-serif"
    when 'bodoni_montserrat'
      assign google_families = 'Bodoni+Moda:wght@400;500;700&family=Montserrat:wght@400;500'
      assign serif_stack = "'Bodoni Moda', ui-serif, Georgia, serif"
      assign sans_stack = "'Montserrat', ui-sans-serif, system-ui, sans-serif"
    else
      assign google_families = 'Cormorant+Garamond:wght@400;500;600&family=Inter:wght@400;500'
      assign serif_stack = "'Cormorant Garamond', ui-serif, Georgia, serif"
      assign sans_stack = "'Inter', ui-sans-serif, system-ui, sans-serif"
  endcase
-%}
{%- if needs_google_fonts -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ google_families }}&display=swap">
{%- endif -%}
{%- if self_hosted == 'playfair_jost' -%}
  <link rel="preload" href="{{ 'pm-playfair-display.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ 'pm-jost.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
{%- endif -%}
{%- style -%}
  {%- if self_hosted == 'playfair_jost' -%}
  @font-face {
    font-family: 'Playfair Display';
    font-style: normal;
    font-weight: 400 900;
    font-display: swap;
    src: url({{ 'pm-playfair-display.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Jost';
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url({{ 'pm-jost.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  {%- endif -%}
  :root {
    --pm-font-serif: {{ serif_stack }};
    --pm-font-sans: {{ sans_stack }};
  }
{%- endstyle -%}
