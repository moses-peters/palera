{%- if settings.cart_type == 'drawer' -%}
  <div id="CartDrawer" class="drawer drawer--right">
    <form id="CartDrawerForm" action="{{ routes.cart_url }}" method="post" novalidate class="drawer__contents" data-location="cart-drawer">
      <div class="drawer__fixed-header">
        <div class="drawer__header appear-animation appear-delay-1">
          <div class="h2 drawer__title">{{ 'cart.general.title' | t }}</div>
          <div class="drawer__close">
            <button type="button" class="drawer__close-button js-drawer-close">
              <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-close" viewBox="0 0 64 64"><title>icon-X</title><path d="m19 17.61 27.12 27.13m0-27.12L19 44.74"/></svg>
              <span class="icon__fallback-text">{{ 'cart.general.close_cart' | t }}</span>
            </button>
          </div>
        </div>
      </div>

      <div class="drawer__inner">
        <div class="drawer__scrollable">
          <div data-products class="appear-animation appear-delay-2"></div>
          {%- comment -%} Order note removed from the drawer on purpose. {%- endcomment -%}
        </div>

        <div class="drawer__footer appear-animation appear-delay-4">
          <div data-discounts>
            {% if cart.cart_level_discount_applications != blank %}
              <div class="cart__discounts cart__item-sub cart__item-row">
                <div>{{ 'cart.general.discounts' | t }}</div>
                <div class="text-right">
                  {% for cart_discount in cart.cart_level_discount_applications %}
                    <div class="cart__discount">
                      {{ cart_discount.title }} (-{{ cart_discount.total_allocated_amount | money }})
                    </div>
                  {% endfor %}
                </div>
              </div>
            {% endif %}
          </div>

          <div class="cart__item-sub cart__item-row">
            <div class="ajaxcart__subtotal">{{ 'cart.general.subtotal' | t }}</div>
            <div data-subtotal>{{ cart.total_price | money }}</div>
          </div>

          <div class="cart__item-row text-center">
            <small>
              {{ 'cart.general.shipping_at_checkout' | t }}<br />
            </small>
          </div>

          {% if settings.cart_terms_conditions_enable %}
            <div class="cart__item-row cart__terms">
              <input type="checkbox" id="CartTermsDrawer" class="cart__terms-checkbox">
              <label for="CartTermsDrawer">
                {% if settings.cart_terms_conditions_page != blank %}
                  {{ 'cart.general.terms_html' | t: url: settings.cart_terms_conditions_page.url }}
                {% else %}
                  {{ 'cart.general.terms' | t }}
                {% endif %}
              </label>
            </div>
          {% endif %}

          <div class="cart__checkout-wrapper kg-cart-drawer-actions">
            <a href="{{ routes.cart_url }}" class="kg-cart-view-bag">{{ 'pm.cart.view_bag' | t }}</a>
            <button type="button" class="js-drawer-close kg-cart-continue-shopping">{{ 'pm.cart.continue_shopping' | t }}</button>

            {% if additional_checkout_buttons and settings.cart_additional_buttons %}
              <div class="additional-checkout-buttons additional-checkout-buttons--vertical">{{ content_for_additional_checkout_buttons }}</div>
            {% endif %}
          </div>

          <style>
            /* ===== PM cart drawer: same type and spacing as the rest of the site ===== */
            #CartDrawer {
              --pm-cd-ink: var(--pm-ink, #1d1d1d);
              --pm-cd-muted: var(--pm-muted, #8a857c);
              --pm-cd-line: var(--pm-line, #e7e5df);
              font-family: var(--pm-font-sans, inherit);
              color: var(--pm-cd-ink);
            }
            #CartDrawer .drawer__title {
              font-family: var(--pm-font-serif, inherit);
              font-size: 26px;
              font-weight: 400;
              letter-spacing: 0;
              text-transform: none;
            }
            #CartDrawer .drawer__header { border-bottom-color: var(--pm-cd-line); }

            /* Line items */
            #CartDrawer .cart__item {
              align-items: center;
              padding: 28px 0;
              margin: 0;
              border-bottom: 1px solid var(--pm-cd-line);
            }
            #CartDrawer .cart__item:last-child { border-bottom: 0; }
            #CartDrawer .cart__image {
              flex: 0 0 140px;
              margin-right: 24px;
            }
            #CartDrawer .cart__image { aspect-ratio: 1 / 1; }
            #CartDrawer .cart__image a,
            #CartDrawer .cart__image .image-wrap { height: 100%; }
            #CartDrawer .cart__image img { height: 100%; width: 100%; object-fit: contain; }
            #CartDrawer .cart__item-details { min-width: 0; }
            #CartDrawer .cart__item-title {
              margin: 0;
              font-family: var(--pm-font-serif, inherit);
              font-size: 19px;
              line-height: 1.25;
              text-transform: none;
              letter-spacing: 0;
            }
            #CartDrawer .cart__item--variants,
            #CartDrawer .cart__item--properties,
            #CartDrawer .pm-cart-gift { font-family: var(--pm-font-sans, inherit); }
            #CartDrawer .cart__item-name {
              display: block;
              font-family: var(--pm-font-serif, inherit);
              font-size: 19px;
              line-height: 1.25;
              font-weight: 400;
              letter-spacing: 0;
              text-transform: none;
              color: var(--pm-cd-ink);
              text-decoration: none;
              margin-bottom: 12px;
            }
            #CartDrawer .cart__item--variants,
            #CartDrawer .cart__item--properties {
              font-size: 10px;
              line-height: 1.9;
              font-weight: 500;
              letter-spacing: 0.14em;
              text-transform: uppercase;
              color: var(--pm-cd-muted);
              margin: 0;
            }
            #CartDrawer .cart__item--variants span,
            #CartDrawer .cart__item--properties span { font-weight: 500; color: var(--pm-cd-muted); }
            #CartDrawer .pm-cart-gift {
              display: flex;
              align-items: flex-start;
              gap: 8px;
              margin: 14px 0 0;
              font-size: 12px;
              line-height: 1.5;
              color: var(--pm-cd-muted);
              text-transform: none;
              letter-spacing: 0;
              cursor: pointer;
            }
            #CartDrawer .pm-cart-gift input { margin: 2px 0 0; flex-shrink: 0; }
            #CartDrawer .cart__item-sub { margin-top: 20px; align-items: center; }
            #CartDrawer .cart__price { font-size: 14px; font-weight: 400; letter-spacing: 0.02em; color: var(--pm-cd-ink); }
            #CartDrawer .cart__remove { margin-top: 10px; }
            #CartDrawer .cart__remove a {
              font-size: 10px;
              letter-spacing: 0.14em;
              text-transform: uppercase;
              color: var(--pm-cd-muted);
            }
            #CartDrawer .js-qty__wrapper { border-color: var(--pm-cd-line); }
            #CartDrawer .js-qty__num { font-family: inherit; font-size: 13px; }

            /* Footer */
            #CartDrawer .drawer__footer { border-top-color: var(--pm-cd-line); padding-top: 24px; }
            #CartDrawer .drawer__footer .cart__item-sub {
              margin: 0 0 6px;
              font-size: 11px;
              font-weight: 500;
              letter-spacing: 0.14em;
              text-transform: uppercase;
            }
            #CartDrawer .drawer__footer [data-subtotal] { font-size: 15px; letter-spacing: 0.02em; text-transform: none; }
            #CartDrawer .drawer__footer small { font-size: 12px; color: var(--pm-cd-muted); letter-spacing: 0; }

            .kg-cart-drawer-actions {
              display: flex;
              flex-direction: column;
              align-items: center;
              gap: 10px;
            }
            #CartDrawer .kg-cart-drawer-actions .kg-cart-view-bag {
              display: block;
              width: 100%;
              box-sizing: border-box;
              text-align: center;
              background-color: #000;
              color: #fff;
              padding: 14px 20px;
              border-radius: 0;
              text-decoration: none;
              font-family: inherit;
              font-size: 11px;
              letter-spacing: 0.14em;
              text-transform: uppercase;
              font-weight: 500;
              border: none;
            }
            #CartDrawer .kg-cart-drawer-actions .kg-cart-view-bag:hover,
            #CartDrawer .kg-cart-drawer-actions .kg-cart-view-bag:focus {
              background-color: #222;
              color: #fff;
            }
            #CartDrawer .kg-cart-drawer-actions .kg-cart-continue-shopping {
              background: none;
              border: none;
              padding: 0;
              margin: 0;
              color: #000;
              text-decoration: underline;
              font-size: 12px;
              cursor: pointer;
              font-family: inherit;
              text-transform: none;
              letter-spacing: normal;
              font-weight: 400;
            }
            #CartDrawer .kg-cart-drawer-actions .kg-cart-continue-shopping:hover,
            #CartDrawer .kg-cart-drawer-actions .kg-cart-continue-shopping:focus {
              opacity: 0.7;
            }
          </style>
        </div>
      </div>

      <div class="drawer__cart-empty appear-animation appear-delay-2">
        <div class="drawer__scrollable">
          {{ 'cart.general.empty' | t }}
        </div>
      </div>
    </form>
  </div>
{%- endif -%}
