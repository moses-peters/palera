{%- comment -%}
  Replaces the removed Wishlist Hero app's header icon. Opens the
  in-house #WishlistDrawer via theme.Drawers (see assets/pm-wishlist.js
  init(), which constructs it) -- same open-button convention as the
  cart icon right next to it (.js-drawer-open-<name> / aria-controls).
{%- endcomment -%}
<a href="{{ routes.root_url }}" class="site-nav__link site-nav__link--icon js-drawer-open-wishlist pm-wishlist-header-icon" aria-controls="WishlistDrawer">
  <svg aria-hidden="true" focusable="false" viewBox="0 0 32 32" class="icon pm-wishlist-icon">
    <path d="M16 27.3c-.3 0-.6-.1-.9-.3C9.3 22.8 4 17.9 4 12.9 4 9 7.1 6 10.9 6c2 0 3.9.9 5.1 2.5C17.2 6.9 19.1 6 21.1 6 24.9 6 28 9 28 12.9c0 5-5.3 9.9-11.1 14.1-.3.2-.6.3-.9.3Z"/>
  </svg>
  <span class="icon__fallback-text visually-hidden">{{ 'products.general.wishlist_title' | t }}</span>
  <span data-pm-wishlist-count class="pm-wishlist-count">0</span>
</a>
