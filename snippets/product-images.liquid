{% comment %}
  Parameters
  context - used to determine whether on the featured product or main product template
  sizes
  sizeVariable
  fallback
  mobile_layout
{% endcomment %}

{%- liquid
  assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media
  assign first_3d_model = product.media | where: 'media_type', 'model' | first

  # Thumbnails load lazily at 80px: they're hidden on phones, and eager
  # loading made phones download a 720px copy of every thumbnail.

  # For products using the image-set feature (color variants with multiple
  # photos grouped via a "#color_x" tag in each media's alt text), this is
  # the group the currently selected photo belongs to. Used below to hide
  # other colors' thumbnails on first render, instead of leaving every
  # color's thumbnails visible until theme.js's updateImageSetThumbs() runs
  # and hides them -- which is what caused all of them to flash on load.
  assign featured_group = ''
  if featured_media.alt contains '#'
    assign featured_group_full = featured_media.alt | split: '#' | last
    if featured_group_full contains '_'
      assign featured_group = featured_group_full
    endif
  endif
-%}

{%- unless product.empty? -%}
  <div
    data-product-images
    data-zoom="{{ product_zoom_enable }}"
    data-has-slideshow="{% if product.media.size > 1 %}true{% else %}false{% endif %}">
    <div class="product__photos product__photos-{{ section_id }} product__photos--{{ thumbnail_position }}{% if product.media.size > 1 and thumbnail_position == 'beside' and image_position == 'left' %} pm-photos--thumbs-left{% endif %}">

      <div class="product__main-photos" data-aos data-product-single-media-group>
        <div
          data-product-photos
          data-zoom="{{ product_zoom_enable }}"
          class="product-slideshow"
          id="ProductPhotos-{{ section_id }}"
        >
          {%- for media in product.media -%}
            {%- comment -%}
              Only the first slide needs to be eager — it's the only one
              visible on page load. The theme previously eager-loaded every
              slide (every color-variant photo, at two widths each), which on
              a product with several colors meant 2MB+ of images nobody was
              looking at yet on every single product-page visit, mobile
              included. Slides 2+ now load natively lazily, the moment the
              visitor actually swipes to them.
            {%- endcomment -%}
            {%- liquid
              assign slide_loading = 'lazy'
              assign slide_sizes = sizes
              assign slide_defer = false
              if context == 'main-product' and media != featured_media
                # Other photos wait until the first one has loaded (or the
                # visitor touches the page) -- see the script after the gallery.
                assign slide_defer = true
                assign slide_sizes = '(min-width: 769px) 720px, 300px'
              endif
              if context == 'main-product' and media == featured_media
                assign slide_loading = 'eager'

                # sizeVariable's vw-based guess (e.g. "40vw") is evaluated
                # against the viewport before Flickity has finished laying
                # the gallery out, and the real column can also be capped by
                # a max-width wrapper further up the page -- so once layout
                # settles the browser can decide a different srcset
                # candidate was actually needed and silently re-fetch it,
                # which looks like this one photo "reloading" a moment after
                # it already appeared correctly. Fixed per-breakpoint values
                # here are known at parse time rather than recomputed after
                # layout, so there's nothing left to re-fetch.
                # Phones: 300px makes 2x-3x screens pick the 720/900px file
                # instead of 1080px, so the first photo arrives sooner.
                # Keep in sync with the hero preload in layout/theme.liquid.
                assign slide_sizes = '(min-width: 769px) 720px, 300px'
              endif
            -%}
            {%- render 'media',
              section_id: section_id,
              media: media,
              featured_media: featured_media,
              loopIndex0: forloop.index0,
              loopIndex: forloop.index,
              product_zoom_enable: product_zoom_enable,
              product_zoom_size: product_zoom_size,
              product_image_size: product_image_size,
              isModal: isModal,
              video_looping: video_looping,
              video_style: video_style,
              sizes: slide_sizes,
              sizeVariable: sizeVariable,
              fallback: fallback,
              loading: slide_loading,
              defer_src: slide_defer,
              mobile_layout: mobile_layout
            -%}
          {%- endfor -%}
        </div>
        {%- if context == 'main-product' -%}
          {%- comment -%}
            The other gallery photos only get their image address once the
            first photo has finished loading, the page has loaded, or the
            visitor touches the page (swipe, swatch tap, key), whichever is
            first -- so they don't share the connection with the first photo.
          {%- endcomment -%}
          <script>
            (function () {
              var gallery = document.getElementById('ProductPhotos-{{ section_id }}');
              if (!gallery) return;
              var done = false;
              function release() {
                if (done) return;
                done = true;
                Array.prototype.forEach.call(gallery.querySelectorAll('img[data-pm-defer-src]'), function (img) {
                  img.srcset = img.getAttribute('data-pm-defer-srcset');
                  img.src = img.getAttribute('data-pm-defer-src');
                  img.removeAttribute('data-pm-defer-src');
                  img.removeAttribute('data-pm-defer-srcset');
                });
              }
              var first = gallery.querySelector('img[loading="eager"]');
              if (!first || first.complete) { release(); return; }
              first.addEventListener('load', release);
              first.addEventListener('error', release);
              window.addEventListener('load', release);
              ['pointerdown', 'touchstart', 'keydown', 'click'].forEach(function (ev) {
                document.addEventListener(ev, release, { capture: true, passive: true, once: true });
              });
            })();
          </script>
        {%- endif -%}

        {%- if first_3d_model -%}
          <button
            aria-label="{{ 'products.product.view_in_space_label' | t }}"
            class="product-single__view-in-space"
            data-shopify-xr
            data-shopify-model3d-id="{{ first_3d_model.id }}"
            data-shopify-title="{{ product.title }}"
            data-shopify-xr-hidden
          >
            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-3d" viewBox="18.24 17.35 24.52 28.3"><path fill="#3A3A3A" d="m30.5 17.35-12.26 7.07v14.16l12.26 7.07 12.26-7.08V24.42L30.5 17.35zM20.24 37.42V25.58l10.26-5.93 10.13 5.85-10.13 5.88v12l-10.26-5.96z"/></svg>
            <span class='product-single__view-in-space-text'>
              {{ 'products.product.view_in_space' | t }}
            </span>
          </button>
        {%- endif -%}
      </div>

      <div
        data-product-thumbs
        class="product__thumbs product__thumbs--{{ thumbnail_position }} product__thumbs-placement--{{ image_position }}{% if product.media.size == 1 %} medium-up--hide{% endif %} small--hide"
        data-position="{{ thumbnail_position }}"
        data-arrows="{{ thumbnail_arrows }}"
        data-aos>
        {%- if thumbnail_arrows -%}
          <button type="button" class="product__thumb-arrow product__thumb-arrow--prev hide">
            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-chevron-left" viewBox="0 0 284.49 498.98"><path d="M249.49 0a35 35 0 0 1 24.75 59.75L84.49 249.49l189.75 189.74a35.002 35.002 0 1 1-49.5 49.5L10.25 274.24a35 35 0 0 1 0-49.5L224.74 10.25A34.89 34.89 0 0 1 249.49 0Z"/></svg>
          </button>
        {%- endif -%}

        <div class="product__thumbs--scroller">
          {%- if product.media.size > 1 -%}
            {%- for media in product.media -%}
              {%- liquid
                assign image_set = false
                assign image_set_group = ''
                assign image_set_full = ''
                if media.alt contains '#'
                  assign image_set_full = media.alt | split: '#' | last
                  if image_set_full contains '_'
                    assign image_set = true
                    assign image_set_group = image_set_full | split: '_' | first
                  endif
                endif

                assign thumb_hidden = false
                if featured_group != '' and image_set_full != featured_group
                  assign thumb_hidden = true
                endif
              -%}
              <div class="product__thumb-item{% if thumb_hidden %} hide{% endif %}"
                data-index="{{ forloop.index0 }}"
                {% if image_set %}
                  data-set-name="{{image_set_group}}"
                  data-group="{{image_set_full}}"
                {% endif %}>
                <a
                  href="{{ media.preview_image | img_url: product_zoom_size }}"
                  data-product-thumb
                  class="product__thumb"
                  data-index="{{ forloop.index0 }}"
                  data-id="{{ media.id }}">
                  <div class="image-wrap" style="height: 0; padding-bottom: {{ 100 | divided_by: media.preview_image.aspect_ratio }}%;">
                    {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                      <span class="product__thumb-icon">
                        <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-play" viewBox="18.24 17.35 24.52 28.3"><path fill="#323232" d="M22.1 19.151v25.5l20.4-13.489-20.4-12.011z"/></svg>
                      </span>
                    {%- endif -%}
                    {%- if media.media_type == 'model' -%}
                      <span class="product__thumb-icon">
                        <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-3d" viewBox="18.24 17.35 24.52 28.3"><path fill="#3A3A3A" d="m30.5 17.35-12.26 7.07v14.16l12.26 7.07 12.26-7.08V24.42L30.5 17.35zM20.24 37.42V25.58l10.26-5.93 10.13 5.85-10.13 5.88v12l-10.26-5.96z"/></svg>
                      </span>
                    {%- endif -%}

                    {%- capture image_classes -%}
                      appear-delay-{{ forloop.index | times: 3 }}
                    {%- endcapture -%}

                    {%- render 'image-element', img: media.preview_image, alt: media.alt, split: '#', widths: '120, 360, 540, 720', sizes: '80px', loading: 'lazy' -%}
                  </div>
                </a>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>

        {%- if thumbnail_arrows -%}
          <button type="button" class="product__thumb-arrow product__thumb-arrow--next">
            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-chevron-right" viewBox="0 0 284.49 498.98"><title>icon-chevron</title><path d="M35 498.98a35 35 0 0 1-24.75-59.75l189.74-189.74L10.25 59.75a35.002 35.002 0 0 1 49.5-49.5l214.49 214.49a35 35 0 0 1 0 49.5L59.75 488.73A34.89 34.89 0 0 1 35 498.98Z"/></svg>
          </button>
        {%- endif -%}
      </div>
    </div>
  </div>

  {% if thumbnail_height == 'fixed' %}
    {% style %}
      .product__photos-{{ section_id }} .product__thumbs:not(.product__thumbs--below) {
        min-height: 400px;
        max-height: 400px;
      }

      @media screen and (max-width: 798px) {
        .product__photos-{{ section_id }} .product__thumbs:not(.product__thumbs--below) {
          min-height: 300px;
          max-height: 300px;
        }
      }
    {% endstyle %}
  {% endif %}

  <script type="application/json" id="ModelJson-{{ section_id }}">
    {{ product.media | where: 'media_type', 'model' | json }}
  </script>
{%- else -%}
  <div class="product__photos product__photos-{{ section_id }}">
    <div class="product__main-photos" style="width: 100%">
      <div data-product-photos>
        <div class="product-main-slide" data-index="{{ forloop.index0 }}">
          <a href="#">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </a>
        </div>
      </div>
    </div>
  </div>
{%- endunless -%}
