{%- comment -%}
  Compact "EN | IT" language switcher. Uses Shopify's own localization
  form (same one snippets/multi-selectors.liquid uses for its dropdown
  version) so no new JS is needed -- each non-current locale is a
  plain submit button (name="locale_code", value="<iso_code>") that
  Shopify's native localization form handler reads directly; works
  even if theme.js hasn't finished loading yet.

  Hidden entirely until a second locale is actually published in
  Shopify Admin (Settings > Languages) -- shop.enabled_locales only
  has more than one entry once that's done, so this has nothing to
  switch between until then.

  Rendered twice on purpose, in two different contexts, each shown on
  only one breakpoint (never both at once):
  - context: 'header' (default) -- next to the account icon in the
    desktop header, white text to read against that bar's dark
    background. Hidden on mobile.
  - context: 'drawer' -- inside the mobile nav drawer's bottom social
    row, as a plain-text item alongside the social icons, inheriting
    the drawer's own (dark-on-light) text color instead of white.
{%- endcomment -%}
{%- if shop.enabled_locales.size > 1 -%}
  {%- liquid
    assign pm_lang_context = context | default: 'header'
  -%}
  {%- form 'localization', class: 'pm-lang-switcher pm-lang-switcher--' | append: pm_lang_context -%}
    <span class="visually-hidden">{{ 'general.language.dropdown_label' | t }}</span>
    {%- for locale in form.available_locales -%}
      {%- unless forloop.first -%}<span class="pm-lang-switcher-sep" aria-hidden="true">|</span>{%- endunless -%}
      {%- if locale.iso_code == form.current_locale.iso_code -%}
        <span class="pm-lang-switcher-option is-current" aria-current="true">{{ locale.iso_code | upcase }}</span>
      {%- else -%}
        <button type="submit" name="locale_code" value="{{ locale.iso_code }}" class="pm-lang-switcher-option" lang="{{ locale.iso_code }}">{{ locale.iso_code | upcase }}</button>
      {%- endif -%}
    {%- endfor -%}
  {%- endform -%}

  <style>
    .pm-lang-switcher {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      margin: 0 2px;
    }
    .pm-lang-switcher-option {
      all: unset;
      font-family: inherit;
      font-size: 11px;
      letter-spacing: 0.06em;
      font-weight: 400;
      cursor: pointer;
    }
    .pm-lang-switcher-option.is-current {
      cursor: default;
      font-weight: 700;
    }
    .pm-lang-switcher-option:focus-visible {
      outline: 1.5px solid currentColor;
      outline-offset: 2px;
    }

    /* Header placement: desktop only, white to read against the
       header's dark background. */
    .pm-lang-switcher--header {
      display: none;
    }
    .pm-lang-switcher--header .pm-lang-switcher-option,
    .pm-lang-switcher--header .pm-lang-switcher-sep {
      color: #fff;
    }
    .pm-lang-switcher--header .pm-lang-switcher-option:not(.is-current):hover,
    .pm-lang-switcher--header .pm-lang-switcher-option:not(.is-current):focus-visible {
      opacity: 0.7;
    }
    @media (min-width: 769px) {
      .pm-lang-switcher--header {
        display: inline-flex;
      }
    }

    /* Drawer placement: mobile only (the drawer itself is mobile-only
       in this theme), plain text matching the drawer's own link
       color instead of a hardcoded one. */
    .pm-lang-switcher--drawer .pm-lang-switcher-option,
    .pm-lang-switcher--drawer .pm-lang-switcher-sep {
      color: inherit;
    }
    .pm-lang-switcher--drawer .pm-lang-switcher-option:not(.is-current):hover,
    .pm-lang-switcher--drawer .pm-lang-switcher-option:not(.is-current):focus-visible {
      opacity: 0.6;
    }
  </style>
{%- endif -%}
