{%- comment -%}
  One campaign/"Editorial break" tile. Shared by pm-collection-grid for
  both the in-grid break points (rendered inline, already in the right
  spot) and the family-scoped tiles (rendered once after the grid,
  starting hidden — JS un-hides and repositions the ones matching the
  active family when a family filter is applied). Params: campaign_block
  (the block), hidden (boolean, true to start with pm-is-hidden applied).

  The tile only becomes a real link when a Link is actually set on the
  block -- otherwise it stays the plain, non-interactive photo it
  always was (aria-hidden reflects that: a real link inside an
  aria-hidden container would still be keyboard-focusable while
  invisible to assistive tech, so aria-hidden only applies when there's
  nothing to focus).
{%- endcomment -%}
{%- assign campaign_has_link = campaign_block.settings.link != blank -%}
<div class="pm-plp-tile pm-plp-campaign-tile{% if campaign_block.settings.orientation == 'vertical' %} pm-plp-campaign-tile--vertical{% endif %}{% if hidden %} pm-is-hidden{% endif %}" data-show-on="{{ campaign_block.settings.show_on }}" data-campaign-family="{{ campaign_block.settings.family }}"{% unless campaign_has_link %} aria-hidden="true"{% endunless %} {{ campaign_block.shopify_attributes }}>
  {%- if campaign_has_link -%}<a href="{{ campaign_block.settings.link }}" class="pm-plp-tile-image pm-plp-tile-image--campaign">{%- else -%}<div class="pm-plp-tile-image pm-plp-tile-image--campaign">{%- endif -%}
    {%- if campaign_block.settings.video_url != blank -%}
      <video autoplay muted loop playsinline{% if campaign_block.settings.image %} poster="{{ campaign_block.settings.image | image_url: width: 1800 }}"{% endif %}>
        <source src="{{ campaign_block.settings.video_url }}" type="video/mp4">
      </video>
    {%- elsif campaign_block.settings.image -%}
      <picture>
        {%- if campaign_block.settings.image_mobile -%}
          <source media="(max-width: 639px)" srcset="{{ campaign_block.settings.image_mobile | image_url: width: 1800 }}">
        {%- endif -%}
        <img src="{{ campaign_block.settings.image | image_url: width: 1800 }}" alt="{{ campaign_block.settings.image.alt | escape | default: campaign_block.settings.caption }}" loading="lazy">
      </picture>
    {%- else -%}
      {% render 'pm-media-placeholder', label: 'Campaign Photo' %}
    {%- endif -%}
  {%- if campaign_has_link -%}</a>{%- else -%}</div>{%- endif -%}
  {%- if campaign_block.settings.caption != blank -%}
    <p class="pm-eyebrow pm-plp-campaign-caption">{{ campaign_block.settings.caption }}</p>
  {%- endif -%}
</div>
