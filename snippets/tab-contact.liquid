{%- comment -%}
  Plain text trigger + slide-in drawer (shared .pm-drawer shell, see
  pm-product.css/pm-product.js) instead of an inline-expanding
  accordion -- same pattern as the "see all colors" swatch picker.

  If the form was just submitted (full-page reload), the drawer opens
  already-expanded so the success/error message is visible right away
  instead of being hidden behind a closed drawer. form.posted_successfully?
  only exists inside the {% form %} block below, so it has to wrap the
  trigger/drawer-wrapper too (not just the form fields) for that check
  to see this specific form's result.
{%- endcomment -%}
{%- assign contact_form_id = 'contact-' | append: id -%}
{%- form 'contact', id: contact_form_id -%}
  {%- assign drawer_open = false -%}
  {%- if form.posted_successfully? -%}
    {%- assign drawer_open = true -%}
  {%- endif -%}
  <button type="button" class="pm-info-trigger" data-pm-drawer-open="pm-info-drawer-{{ id }}">{{ block.settings.title }}</button>
  <div class="pm-drawer{% if drawer_open %} pm-drawer--open{% endif %}" data-pm-drawer id="pm-info-drawer-{{ id }}"{% unless drawer_open %} hidden{% endunless %}>
    <div class="pm-drawer__overlay" data-pm-drawer-close></div>
    <div class="pm-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ block.settings.title | strip_html | escape }}">
      <div class="pm-drawer__header">
        <span class="pm-drawer__title">{{ block.settings.title }}</span>
        <button type="button" class="pm-drawer__close" data-pm-drawer-close aria-label="Close">&times;</button>
      </div>
      <div class="pm-drawer__body pm-policy-body">
        {%- if form.posted_successfully? -%}
          <p class="note note--success">
            {{ 'contact.form.post_success' | t }}
          </p>
        {%- endif -%}

        {%- if form.product -%}
          {{ form.errors | default_errors }}
        {%- endif -%}

        <div class="form-vertical">
          <input type="hidden" name="contact[product]" value="Product question for: {{ shop.secure_url }}{{ product.url }}">

          <div class="pm-form-row">
            <div>
              <label for="ContactFormName-{{ id }}">{{ 'contact.form.name' | t }}</label>
              <input type="text" id="ContactFormName-{{ id }}" class="input-full" name="contact[name]" autocapitalize="words" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
            </div>

            <div>
              <label for="ContactFormEmail-{{ id }}">{{ 'contact.form.email' | t }}</label>
              <input type="email" id="ContactFormEmail-{{ id }}" class="input-full" name="contact[email]" autocorrect="off" autocapitalize="off" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
            </div>
          </div>

          {%- if block.settings.phone -%}
            <label for="ContactFormPhone-{{ id }}">{{ 'contact.form.phone' | t }}</label>
            <input type="tel" id="ContactFormPhone-{{ id }}" class="input-full" name="contact[phone]" pattern="[0-9\-]*" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}">
          {%- endif -%}

          <label for="ContactFormMessage-{{ id }}">{{ 'contact.form.message' | t }}</label>
          <textarea rows="5" id="ContactFormMessage-{{ id }}" class="input-full" name="contact[body]">{% if form.body %}{{ form.body }}{% endif %}</textarea>

          <label for="tab-contact-submit-{{ id }}" class="hidden-label">{{ 'contact.form.send' | t }}</label>
          <button type="submit" id="tab-contact-submit-{{ id }}" class="btn">
            {{ 'contact.form.send' | t }}
          </button>

          <p class="pm-contact-email-note">Or email us at <a href="mailto:clientservice@paleramilano.com">clientservice@paleramilano.com</a></p>

          {% comment %}
            Remove the following three lines of code to remove the note
            about being protected by Google's reCAPTCHA service.
            By removing it, the small reCAPTCHA widget will appear in the
            bottom right corner of the page.
          {% endcomment %}
          <div class="pm-recaptcha-disclaimer">{{ 'shopify.online_store.spam_detection.disclaimer_html' | t }}</div>
        </div>
      </div>
    </div>
  </div>
{%- endform -%}
