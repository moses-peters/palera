{%- comment -%}
  Fixed 4-item nav (Home / AW27 / Shop / About Us) — intentionally ignores
  the store's main-menu link list. About Us / AW27 URLs come from the
  header section's settings (theme editor), since they can't be known
  from theme code. Shop is a real link to the Shop All page, whose top
  section (sections/pm-shop-browse) is the family-grid browse content
  that used to only exist as a hover/click dropdown here — clicking
  "Shop" opened an overlay on top of whatever page you were on rather
  than actually going anywhere.
{%- endcomment -%}
<ul class="site-nav site-navigation small--hide">
  <li class="site-nav__item site-nav__expanded-item">
    <a href="{{ routes.root_url }}" class="site-nav__link site-nav__link--underline">Home</a>
  </li>
  <li class="site-nav__item site-nav__expanded-item">
    <a href="{{ aw27_url | default: '/collections/aw27' }}" class="site-nav__link site-nav__link--underline">AW27</a>
  </li>
  <li class="site-nav__item site-nav__expanded-item">
    <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="site-nav__link site-nav__link--underline">Shop</a>
  </li>
  <li class="site-nav__item site-nav__expanded-item">
    <a href="{{ about_us_url | default: '/pages/about-us' }}" class="site-nav__link site-nav__link--underline">About Us</a>
  </li>
</ul>
