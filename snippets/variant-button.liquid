{%- assign swatch_file_extension = 'png' -%}

{%- capture size_chart_title -%}
  {{ 'products.general.size_chart' | t }} <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-size-chart" viewBox="0 0 64 64"><path d="M22.39 33.53c-7.46 0-13.5-3.9-13.5-8.72s6-8.72 13.5-8.72 13.5 3.9 13.5 8.72a12 12 0 0 1-.22 1.73"/><ellipse cx="22.39" cy="24.81" rx="3.28" ry="2.12"/><path d="M8.89 24.81V38.5c0 7.9 6.4 9.41 14.3 9.41h31.92V33.53H22.39m24.39 0v7.44m-8.13-7.44v7.44m-8.13-7.44v7.44m-8.13-7.44v7.44"/></svg>
{%- endcapture -%}

{%- liquid
  assign is_size = false
  assign size_trigger = 'products.general.size_trigger' | t | downcase
  assign downcased_option = option.name | downcase

  if downcased_option contains size_trigger
    assign is_size = true
  endif
-%}

<div class="variant-wrapper js" data-type="button">
  <label class="variant__label{% if option.name == 'Default' or option.name == 'Title' %} hidden-label{% endif %}{% unless variant_labels %} hidden-label{% endunless %}"
    for="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ forloop.index0 }}">
    {{ option.name }}
    {%- if connect_to_sizechart and is_size -%}
      <span class="variant__label-info">
        &mdash;
        {%- render
          'tool-tip-trigger',
          title: size_chart_title,
          content: section.blocks[sizechart_index].settings.size_chart.content,
          context: 'size-chart'
        -%}
      </span>
    {%- endif -%}
    {%- if is_color -%}
      <span class="variant__label-info">
        &mdash;
        <span
          data-variant-color-label
          data-index="{{ forloop.index0 }}"
          data-option-index="{{ color_option_index }}">
          {{ option.selected_value }}
        </span>
      </span>
    {%- endif -%}
  </label>
  {%- assign option_index = forloop.index -%}
  <fieldset class="variant-input-wrap"
    name="{{ option.name }}"
    data-index="option{{ option_index }}"
    data-handle="{{ option.name | handleize }}"
    id="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ forloop.index0 }}">
    <legend class="hide">{{ option.name }}</legend>
    {%- for value in option.values -%}
      {%- liquid
        assign product_available = true
        if product.options.size == 1
          assign product_available = product.variants[forloop.index0].available
        endif
      -%}
      <div
        class="variant-input"
        data-index="option{{ option_index }}"
        data-value="{{ value | escape }}">
        <input type="radio"
          form="{{ form_id }}"
          {% if option.selected_value == value %} checked="checked"{% endif %}
          value="{{ value | escape }}"
          data-index="option{{ option_index }}"
          name="{{ option.name }}"
          data-variant-input
          class="{% unless product_available %} disabled{% endunless %}{% if is_color %} variant__input--color-swatch{% endif %}"
          {% if is_color %} data-color-name="{{ value | escape }}"{% endif %}
          {% if is_color %} data-color-index="{{ color_option_index }}"{% endif %}
          id="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ option.name | handleize }}-{{ value | url_encode }}">
        {%- if is_color -%}
          {%- liquid
            assign color_file_name = value | handle | append: '.' | append: swatch_file_extension
            assign color_swatch_fallback = value | split: ' ' | last | handle
            assign has_image = false

            # The option literally named "Color" and any "Hardware" option both use
            # the per-variant photo lookup -- each of their values already has a real
            # product photo (a specific bag color, or a specific hardware finish)
            # rather than a swatch-file-friendly plain color. Anything else that's
            # swatch-enabled (e.g. "Chain Color") keeps the original shared
            # swatch-file behavior instead.
            assign swatch_trigger = 'products.general.color_swatch_trigger' | t | downcase
            assign option_name_downcased = option.name | downcase
            assign is_main_color_option = false
            if option_name_downcased == swatch_trigger
              assign is_main_color_option = true
            elsif swatch_trigger == 'color' and option_name_downcased == 'colour'
              assign is_main_color_option = true
            elsif option_name_downcased contains 'hardware'
              assign is_main_color_option = true
            endif

            # Hardware/Chain Color is always literally Gold or Silver, on
            # every product -- a plain, consistent metallic swatch reads
            # better here than each product's own photo (which varies in
            # lighting/crop) or a flat "gold"/"silver" CSS keyword (which
            # looks flat, not metallic). Skips the whole photo lookup
            # below entirely when this is the case.
            assign is_hardware_swatch = false
            assign value_downcased = value | downcase
            if option_name_downcased contains 'hardware' or option_name_downcased contains 'chain color'
              if value_downcased == 'gold'
                assign is_hardware_swatch = true
                assign hardware_css = 'linear-gradient(135deg, #d3b56a 0%, #f7ecc7 22%, #a9822f 50%, #f7ecc7 78%, #d3b56a 100%)'
              elsif value_downcased == 'silver'
                assign is_hardware_swatch = true
                assign hardware_css = 'linear-gradient(135deg, #c6c6c6 0%, #f5f5f5 22%, #9a9a9a 50%, #f5f5f5 78%, #c6c6c6 100%)'
              endif
            endif

            if is_hardware_swatch
              assign is_main_color_option = false
            endif

            if is_main_color_option
              assign option_number = color_option_index | plus: 1
              assign option_key = 'option' | append: option_number

              # On a product with more than one swatch-style axis (e.g. Color AND
              # Hardware), matching on this axis alone can land on a variant whose
              # OTHER axis doesn't match what's currently selected -- e.g. picking
              # the Hardware swatch photo from a "White" colorway instead of the
              # currently-selected "Black" one. Narrow to variants that also match
              # every other option's currently-selected value first, before falling
              # back to a match on this axis alone.
              assign strict_variants = product.variants
              for other_option in product.options_with_values
                unless other_option.name == option.name
                  assign other_key = 'option' | append: other_option.position
                  assign strict_variants = strict_variants | where: other_key, other_option.selected_value
                endunless
              endfor
              assign strict_variants = strict_variants | where: option_key, value
              assign matching_variant = strict_variants | first

              if matching_variant == nil
                assign matching_variant = product.variants | where: option_key, value | first
              endif

              if matching_variant and matching_variant.featured_image
                assign color_image = matching_variant.featured_image | image_url: width: 100
                assign has_image = true
              else
                # The best variant found above (by array order) may have no photo
                # of its own, even though another combo sharing this same axis
                # value does -- check all of them rather than showing a blank
                # swatch for an otherwise photographed value. Prefer the strict
                # (other-axes-matching) set when it has anything, so this fallback
                # still respects the currently-selected other option(s).
                assign color_variants = strict_variants
                if color_variants.size == 0
                  assign color_variants = product.variants | where: option_key, value
                endif
                for color_variant in color_variants
                  if has_image == false and color_variant.featured_image
                    assign color_image = color_variant.featured_image | image_url: width: 100
                    assign has_image = true
                  endif
                endfor
              endif
            endif

          -%}
          {%- liquid
            unless has_image or is_hardware_swatch
              assign color_image = color_file_name | file_img_url: '50x50' | prepend: 'https:' | split: '?' | first
              if images[color_file_name] != blank
                assign has_image = true
              endif
            endunless
          -%}
          {%- comment -%}
            Neither a variant photo nor a theme asset file named after
            this color exists for several of Palera's own custom crystal
            color names (Camelot, Phantom, Gamboge, anything ending in
            "Multi", etc.) -- without this, color_swatch_fallback below
            just uses the color's last word as a raw CSS background-color
            value, which is only ever right by coincidence (works for
            "Rare Pink", breaks for "Gamboge Multi" or "Camelot" outright,
            rendering a blank circle). Reuses the same curated
            crystal-close-up swatch photos already used correctly on the
            collection grid, via pm-crystal-swatch-url. Skipped for
            Hardware/Chain Color -- its own plain gold/silver gradient
            takes over instead, otherwise "Gold" would match the curated
            crystal-swatch list's own unrelated "Gold" bag-color photo.
          {%- endcomment -%}
          {%- unless has_image or is_hardware_swatch -%}
            {%- capture pm_swatch_image -%}{% render 'pm-crystal-swatch-url', color_value: value %}{%- endcapture -%}
            {%- assign pm_swatch_image = pm_swatch_image | strip -%}
            {%- if pm_swatch_image != blank -%}
              {%- assign color_image = pm_swatch_image -%}
              {%- assign has_image = true -%}
            {%- endif -%}
          {%- endunless -%}
          <label
            for="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ option.name | handleize }}-{{ value | url_encode }}"
            class="variant__button-label color-swatch color-swatch--{{ value | handle }}{% unless product_available %} disabled{% endunless %}"
            style="{% if is_hardware_swatch %}background: {{ hardware_css }};{% elsif has_image %}background-image: url({{ color_image }});{% else %}background-color: {{ color_swatch_fallback }};{% endif %}"
          >
            {%- comment -%}
              This label's own text-indent:-9999px (theme.css.liquid)
              is the classic way to hide this text visually while
              keeping it readable to screen readers, but it isn't
              reliable on every iOS Safari configuration -- confirmed
              on one such phone, the label text stayed visible,
              clipped mid-word by the swatch circle's overflow:hidden,
              instead of being pushed off-screen. Wrapping it in the
              theme's own clip-based visually-hidden utility as a
              second, more robust hiding mechanism that doesn't rely
              on shifting text position at all.
            {%- endcomment -%}
            <span class="pm-visually-hidden">{{ value | escape }}</span>
          </label>
        {%- else -%}
          <label
            for="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ option.name | handleize }}-{{ value | url_encode }}"
            class="variant__button-label{% unless product_available %} disabled{% endunless %}">{{ value | escape }}</label>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </fieldset>
</div>