{%- comment -%}
  "Shop" mega-menu panel — one glance at every bag family, styled after
  the Jacquemus nav dropdown: quick links | family grid | campaign panel.
  Rendered inside a stock <details class="site-nav__dropdown megamenu">
  (see header-desktop-nav.liquid) so hover-open/close and full-width
  positioning come from the theme's existing mega-menu CSS/JS — only the
  inner content here is custom.

  Right panel: hovering a family (left link or grid tile) swaps the big
  campaign-style photo from the default AW27 image to that family's own
  flagship shot, same treatment (full image + eyebrow + name + link) —
  matches the reference Jacquemus behavior where the right panel always
  shows one full product photo, not a list. Leaving the menu, or
  hovering Shop All, reverts to the AW27 panel.
{%- endcomment -%}
{{ 'pm-homepage.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign family_groups = 'Roma|maxi-roma-0,Santorini|santorini-6,Clutch|clutch-edge-long-silver-blue,Pouch|crystal-pouch,Wallet|crystal-wallet-rare-pink,Capri|capri-bag-gold,Amelia|amelia-bag-gold,Other Bags|mini-milano-n2-sparkle-blue,Accessories|mirage-necklace-green' | split: ','
-%}

<div class="pm-homepage">
  <div class="pm-shop-menu">
    <div class="pm-shop-menu-links">
      <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="pm-shop-menu-links-item pm-shop-menu-links-item--all">Shop All</a>
      <a href="/collections" class="pm-shop-menu-links-item pm-shop-menu-links-item--all">Shop by Family</a>
      <a href="/collections/aw27" class="pm-shop-menu-links-item">New: AW27</a>
      {%- for group in family_groups -%}
        {%- assign group_parts = group | split: '|' -%}
        {%- assign group_name = group_parts[0] -%}
        {%- assign rep_product = all_products[group_parts[1]] -%}
        {%- if rep_product != blank -%}
          <a href="{{ rep_product.url }}" class="pm-shop-menu-links-item" data-family="{{ group_name | handle }}">{{ group_name }}</a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="pm-shop-menu-grid">
      {%- for group in family_groups -%}
        {%- assign group_parts = group | split: '|' -%}
        {%- assign group_name = group_parts[0] -%}
        {%- assign rep_product = all_products[group_parts[1]] -%}
        {%- if rep_product != blank -%}
          <a href="{{ rep_product.url }}" class="pm-shop-menu-tile" data-family="{{ group_name | handle }}">
            {%- if rep_product.featured_image -%}
              <img src="{{ rep_product.featured_image | image_url: width: 260 }}" alt="{{ group_name }}" loading="lazy">
            {%- else -%}
              {% render 'pm-media-placeholder', label: group_name %}
            {%- endif -%}
            <span>{{ group_name }}</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
      <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="pm-shop-menu-tile" data-family="shop-all">
        <img src="{{ 'pm-about-duo-a.jpg' | asset_url }}" alt="Shop All" loading="lazy">
        <span>Shop All</span>
      </a>
    </div>

    <div class="pm-shop-menu-side">
      <a href="/collections/aw27" class="pm-shop-menu-feature" data-shop-menu-panel data-shop-menu-default>
        <img src="{{ 'pm-drive-hero.jpg' | asset_url }}" alt="AW27">
        <span class="pm-shop-menu-feature-copy">
          <span class="pm-eyebrow">New Season</span>
          <span class="pm-serif">AW27</span>
          <span class="pm-link" style="margin-top:10px;">Discover the Collection</span>
        </span>
      </a>

      {%- for group in family_groups -%}
        {%- assign group_parts = group | split: '|' -%}
        {%- assign group_name = group_parts[0] -%}
        {%- assign rep_product = all_products[group_parts[1]] -%}
        {%- if rep_product != blank -%}
          <a href="{{ rep_product.url }}" class="pm-shop-menu-feature" data-shop-menu-panel data-family="{{ group_name | handle }}" hidden>
            {%- if rep_product.featured_image -%}
              <img src="{{ rep_product.featured_image | image_url: width: 700 }}" alt="{{ group_name }}">
            {%- else -%}
              {% render 'pm-media-placeholder', label: group_name %}
            {%- endif -%}
            <span class="pm-shop-menu-feature-copy">
              <span class="pm-eyebrow">Palera Milano</span>
              <span class="pm-serif">{{ group_name }}</span>
              <span class="pm-link" style="margin-top:10px;">Shop {{ group_name }}</span>
            </span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (function () {
    document.addEventListener('mouseover', function (e) {
      var trigger = e.target.closest('[data-family]');
      if (!trigger) return;
      var menu = trigger.closest('.pm-shop-menu');
      if (!menu) return;
      var family = trigger.getAttribute('data-family');
      var panels = menu.querySelectorAll('[data-shop-menu-panel]');
      var match = menu.querySelector('[data-shop-menu-panel][data-family="' + family + '"]');
      var fallback = menu.querySelector('[data-shop-menu-default]');
      var show = match || fallback;
      panels.forEach(function (panel) {
        panel.hidden = (panel !== show);
      });
    });

    document.querySelectorAll('.pm-shop-menu').forEach(function (menu) {
      menu.addEventListener('mouseleave', function () {
        var fallback = menu.querySelector('[data-shop-menu-default]');
        menu.querySelectorAll('[data-shop-menu-panel]').forEach(function (panel) {
          panel.hidden = (panel !== fallback);
        });
      });
    });
  })();
</script>
