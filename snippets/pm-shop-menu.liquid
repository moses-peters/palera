{%- comment -%}
  "Shop" mega-menu panel — matches the Jacquemus nav dropdown exactly:
  a plain-text category sidebar, a 3x3 grid of real products (photo +
  name, no price — this is a browse panel, not a PLP), and a single
  static campaign image on the right. No hover-swap behavior: the
  campaign panel never changes based on what you're looking at.

  Opens on click, not hover — see header-desktop-nav.liquid, where the
  <details> lost its data-hover attribute so native <details>/<summary>
  click-toggle takes over. Closes via the X button here or a click
  outside the panel (see script below).
{%- endcomment -%}
{{ 'pm-homepage.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign family_groups = 'Roma|maxi-roma-0,Santorini|santorini-6,Clutch|clutch-edge-long-silver-blue,Pouch|crystal-pouch,Wallet|crystal-wallet-rare-pink,Capri|capri-bag-gold,Amelia|amelia-bag-gold,Other Bags|mini-milano-n2-sparkle-blue,Accessories|mirage-necklace-green' | split: ','
-%}

<div class="pm-homepage">
  <div class="pm-shop-menu">
    <button type="button" class="pm-shop-menu-close" data-shop-menu-close aria-label="Close menu">
      <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-close" viewBox="0 0 64 64"><title>icon-X</title><path d="m19 17.61 27.12 27.13m0-27.12L19 44.74"/></svg>
    </button>

    <nav class="pm-shop-menu-links">
      <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="pm-shop-menu-links-item">View all</a>
      <a href="/collections/aw27" class="pm-shop-menu-links-item">New In</a>
      {%- for group in family_groups -%}
        {%- assign group_parts = group | split: '|' -%}
        {%- assign group_name = group_parts[0] -%}
        {%- assign rep_product = all_products[group_parts[1]] -%}
        {%- if rep_product != blank -%}
          <a href="{{ rep_product.url }}" class="pm-shop-menu-links-item">{{ group_name }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <div class="pm-shop-menu-grid">
      {%- for group in family_groups -%}
        {%- assign group_parts = group | split: '|' -%}
        {%- assign rep_product = all_products[group_parts[1]] -%}
        {%- if rep_product != blank -%}
          <a href="{{ rep_product.url }}" class="pm-shop-menu-tile">
            {%- if rep_product.featured_image -%}
              <img src="{{ rep_product.featured_image | image_url: width: 400 }}" alt="{{ rep_product.title | escape }}" loading="lazy">
            {%- else -%}
              {% render 'pm-media-placeholder', label: rep_product.title %}
            {%- endif -%}
            <span>{{ rep_product.title }}</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <a href="/collections/aw27" class="pm-shop-menu-feature">
      <img src="{{ 'pm-drive-hero.jpg' | asset_url }}" alt="AW27 — New Season">
      <span class="pm-shop-menu-feature-copy">
        <span class="pm-shop-menu-feature-title">&ldquo;AW27&rdquo;</span>
        <span class="pm-link">Discover the collection</span>
      </span>
    </a>
  </div>
</div>

<script>
  (function () {
    document.querySelectorAll('[data-shop-menu-close]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var details = btn.closest('details');
        if (details) {
          details.removeAttribute('open');
          details.setAttribute('aria-expanded', 'false');
        }
      });
    });

    document.addEventListener('click', function (e) {
      document.querySelectorAll('.site-nav--is-megamenu > details[open]').forEach(function (details) {
        if (!details.contains(e.target)) {
          details.removeAttribute('open');
          details.setAttribute('aria-expanded', 'false');
        }
      });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      document.querySelectorAll('.site-nav--is-megamenu > details[open]').forEach(function (details) {
        details.removeAttribute('open');
        details.setAttribute('aria-expanded', 'false');
      });
    });
  })();
</script>
