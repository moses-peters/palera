{%- comment -%}
  "Shop" mega-menu panel — three zones: quick links (View All / New In /
  the four categories) on the left, the family grid (photo + name) in
  the middle, and a preview panel on the right that swaps to show a
  placeholder product photo + short description for whichever family is
  currently hovered/focused in the grid. Real photos and per-family
  links are left as an easy swap for later, same as every other
  placeholder in this theme.

  Opens on click, not hover — see header-desktop-nav.liquid, where the
  <details> lost its data-hover attribute so native <details>/<summary>
  click-toggle takes over. Closes via the X button here, a click
  outside the panel, or Escape (see script below).
{%- endcomment -%}
{{ 'pm-homepage.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign categories = 'Clutches,Accessories,Mini Bags,Fits A Phone' | split: ','
  assign families = 'Clutches|Compact, hand-set crystal clutches for evening.;;Accessories|Necklaces, belts, and the finishing details.;;Pouches|Soft crystal pouches, worn crossbody or in hand.;;Wallets|Compact crystal wallets, sized to fit a phone.;;Maxi Roma|The Roma silhouette, in its fullest form.;;Mini Milano|Milano architecture, scaled down.;;Mini Roma|A smaller take on the signature Roma.;;Santorini|Sun-bleached crystal, inspired by the Cyclades.;;Wood Net Hobo|Hand-netted crystal over a wood frame.' | split: ';;'
-%}

<div class="pm-homepage">
  <div class="pm-shop-menu">
    <button type="button" class="pm-shop-menu-close" data-shop-menu-close aria-label="Close menu">
      <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-close" viewBox="0 0 64 64"><title>icon-X</title><path d="m19 17.61 27.12 27.13m0-27.12L19 44.74"/></svg>
    </button>

    <nav class="pm-shop-menu-links">
      <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="pm-shop-menu-links-item">View All</a>
      <a href="/collections/aw27" class="pm-shop-menu-links-item">New In</a>
      {%- for category in categories -%}
        <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="pm-shop-menu-links-item">{{ category }}</a>
      {%- endfor -%}
    </nav>

    <div class="pm-shop-menu-grid">
      {%- for family in families -%}
        {%- assign parts = family | split: '|' -%}
        {%- assign family_name = parts[0] -%}
        <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="pm-shop-menu-family" data-family="{{ family_name | handle }}">
          {% render 'pm-media-placeholder', label: family_name %}
          <span>{{ family_name }}</span>
        </a>
      {%- endfor -%}
    </div>

    <div class="pm-shop-menu-preview">
      {%- for family in families -%}
        {%- assign parts = family | split: '|' -%}
        {%- assign family_name = parts[0] -%}
        {%- assign family_desc = parts[1] -%}
        <div class="pm-shop-menu-preview-panel" data-family-panel="{{ family_name | handle }}" {% unless forloop.first %}hidden{% endunless %}>
          {% render 'pm-media-placeholder', label: family_name %}
          <span class="pm-shop-menu-preview-name">{{ family_name }}</span>
          <p class="pm-shop-menu-preview-desc">{{ family_desc }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (function () {
    function showFamily(menu, family) {
      var panels = menu.querySelectorAll('[data-family-panel]');
      var match = menu.querySelector('[data-family-panel="' + family + '"]');
      if (!match) return;
      panels.forEach(function (panel) {
        panel.hidden = (panel !== match);
      });
    }

    document.addEventListener('mouseover', function (e) {
      var trigger = e.target.closest('[data-family]');
      if (!trigger) return;
      var menu = trigger.closest('.pm-shop-menu');
      if (!menu) return;
      showFamily(menu, trigger.getAttribute('data-family'));
    });

    document.addEventListener('focusin', function (e) {
      var trigger = e.target.closest('[data-family]');
      if (!trigger) return;
      var menu = trigger.closest('.pm-shop-menu');
      if (!menu) return;
      showFamily(menu, trigger.getAttribute('data-family'));
    });

    document.querySelectorAll('[data-shop-menu-close]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var details = btn.closest('details');
        if (details) {
          details.removeAttribute('open');
          details.setAttribute('aria-expanded', 'false');
        }
      });
    });

    document.addEventListener('click', function (e) {
      document.querySelectorAll('.site-nav--is-megamenu > details[open]').forEach(function (details) {
        if (!details.contains(e.target)) {
          details.removeAttribute('open');
          details.setAttribute('aria-expanded', 'false');
        }
      });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      document.querySelectorAll('.site-nav--is-megamenu > details[open]').forEach(function (details) {
        details.removeAttribute('open');
        details.setAttribute('aria-expanded', 'false');
      });
    });
  })();
</script>
