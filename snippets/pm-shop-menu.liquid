{%- comment -%}
  "Shop" browse panel — three zones: quick links (View All / New In /
  the four categories) on the left, the family grid (photo + name) in
  the middle, and a preview panel on the right that swaps to show a
  placeholder product photo + short description for whichever family is
  currently hovered/focused in the grid. Real photos and per-family
  links are left as an easy swap for later, same as every other
  placeholder in this theme.

  Renders as its own real page (sections/pm-shop-browse.liquid, at
  /collections) rather than a hover/click dropdown — it used to be a
  <details> mega-menu, but that meant "Shop" never actually navigated
  anywhere, it only toggled an overlay on top of whatever page you were
  already on. Picking a family here goes on to that family's actual
  products (/collections/all?family=...); this page itself never shows
  products, only the family picker.
{%- endcomment -%}
{{ 'pm-homepage.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  pm-family-data is rendered, not included — some shops reject
  the include tag outright ("Include usage is not allowed in this
  context"). {% render %} runs in an isolated scope, so it can't
  assign into this template directly; capture its text output instead
  and split it here.
{%- endcomment -%}
{%- capture pm_families_raw -%}{% render 'pm-family-data' %}{%- endcapture -%}
{%- liquid
  assign pm_families = pm_families_raw | strip | split: ';;'
  assign categories = 'Clutches,Accessories,Mini Bags,Fits A Phone' | split: ','
-%}

<div class="pm-homepage">
  <div class="pm-shop-menu">
    <nav class="pm-shop-menu-links">
      <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="pm-shop-menu-links-item">View All</a>
      <a href="/collections/aw27" class="pm-shop-menu-links-item">New In</a>
      {%- for category in categories -%}
        <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="pm-shop-menu-links-item">{{ category }}</a>
      {%- endfor -%}
    </nav>

    <div class="pm-shop-menu-grid">
      {%- for family in pm_families -%}
        {%- assign parts = family | split: '|' -%}
        {%- assign family_name = parts[0] -%}
        {%- assign family_handle = family_name | handle -%}
        {%- comment -%}
          Each of the 9 real families maps to its own named image/video
          param passed in from pm-shop-browse.liquid (render runs in
          an isolated scope, so these can't be looked up generically —
          case/when matches the handle to the right pair).
        {%- endcomment -%}
        {%- case family_handle -%}
          {%- when 'clutches' -%}{%- assign family_image = clutches_image -%}{%- assign family_video = clutches_video -%}
          {%- when 'accessories' -%}{%- assign family_image = accessories_image -%}{%- assign family_video = accessories_video -%}
          {%- when 'pouches' -%}{%- assign family_image = pouches_image -%}{%- assign family_video = pouches_video -%}
          {%- when 'wallets' -%}{%- assign family_image = wallets_image -%}{%- assign family_video = wallets_video -%}
          {%- when 'maxi-roma' -%}{%- assign family_image = maxi_roma_image -%}{%- assign family_video = maxi_roma_video -%}
          {%- when 'mini-milano' -%}{%- assign family_image = mini_milano_image -%}{%- assign family_video = mini_milano_video -%}
          {%- when 'mini-roma' -%}{%- assign family_image = mini_roma_image -%}{%- assign family_video = mini_roma_video -%}
          {%- when 'santorini' -%}{%- assign family_image = santorini_image -%}{%- assign family_video = santorini_video -%}
          {%- when 'wood-net-hobo' -%}{%- assign family_image = wood_net_hobo_image -%}{%- assign family_video = wood_net_hobo_video -%}
          {%- else -%}{%- assign family_image = nil -%}{%- assign family_video = nil -%}
        {%- endcase -%}
        <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}?family={{ family_handle }}" class="pm-shop-menu-family" data-family="{{ family_handle }}">
          {% render 'pm-family-media', media_video: family_video, media_image: family_image, media_label: family_name, media_width: 500 %}
          <span>{{ family_name }}</span>
        </a>
      {%- endfor -%}
    </div>

    <div class="pm-shop-menu-preview">
      {%- for family in pm_families -%}
        {%- assign parts = family | split: '|' -%}
        {%- assign family_name = parts[0] -%}
        {%- assign family_desc = parts[1] -%}
        {%- assign family_handle = family_name | handle -%}
        {%- case family_handle -%}
          {%- when 'clutches' -%}{%- assign family_image = clutches_image -%}{%- assign family_video = clutches_video -%}
          {%- when 'accessories' -%}{%- assign family_image = accessories_image -%}{%- assign family_video = accessories_video -%}
          {%- when 'pouches' -%}{%- assign family_image = pouches_image -%}{%- assign family_video = pouches_video -%}
          {%- when 'wallets' -%}{%- assign family_image = wallets_image -%}{%- assign family_video = wallets_video -%}
          {%- when 'maxi-roma' -%}{%- assign family_image = maxi_roma_image -%}{%- assign family_video = maxi_roma_video -%}
          {%- when 'mini-milano' -%}{%- assign family_image = mini_milano_image -%}{%- assign family_video = mini_milano_video -%}
          {%- when 'mini-roma' -%}{%- assign family_image = mini_roma_image -%}{%- assign family_video = mini_roma_video -%}
          {%- when 'santorini' -%}{%- assign family_image = santorini_image -%}{%- assign family_video = santorini_video -%}
          {%- when 'wood-net-hobo' -%}{%- assign family_image = wood_net_hobo_image -%}{%- assign family_video = wood_net_hobo_video -%}
          {%- else -%}{%- assign family_image = nil -%}{%- assign family_video = nil -%}
        {%- endcase -%}
        <div class="pm-shop-menu-preview-panel" data-family-panel="{{ family_handle }}" {% unless forloop.first %}hidden{% endunless %}>
          {% render 'pm-family-media', media_video: family_video, media_image: family_image, media_label: family_name, media_width: 700 %}
          <span class="pm-shop-menu-preview-name">{{ family_name }}</span>
          <p class="pm-shop-menu-preview-desc">{{ family_desc }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (function () {
    function showFamily(menu, family) {
      var panels = menu.querySelectorAll('[data-family-panel]');
      var match = menu.querySelector('[data-family-panel="' + family + '"]');
      if (!match) return;
      panels.forEach(function (panel) {
        panel.hidden = (panel !== match);
      });
    }

    document.addEventListener('mouseover', function (e) {
      var trigger = e.target.closest('[data-family]');
      if (!trigger) return;
      var menu = trigger.closest('.pm-shop-menu');
      if (!menu) return;
      showFamily(menu, trigger.getAttribute('data-family'));
    });

    document.addEventListener('focusin', function (e) {
      var trigger = e.target.closest('[data-family]');
      if (!trigger) return;
      var menu = trigger.closest('.pm-shop-menu');
      if (!menu) return;
      showFamily(menu, trigger.getAttribute('data-family'));
    });
  })();
</script>
