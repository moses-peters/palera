{% if settings.show_breadcrumbs %}

{% unless template.name == 'index' or template.name == 'cart' %}
  {%- comment -%}
    pm_crumbs builds the same trail as the visible <nav> below, as a
    "Label::URL;;Label::URL" string (this codebase's established
    delimiter convention for ad-hoc lists in Liquid, e.g.
    pm-family-data.liquid) -- parsed into a BreadcrumbList JSON-LD
    block at the end. Kept in lockstep with the visible markup
    deliberately: Google treats structured data that doesn't match
    what's actually shown on the page as invalid and can ignore or
    penalize it, so every crumb appended to pm_crumbs mirrors a
    label/url pair already being printed in the <nav> -- plus the
    current page itself as the final item on product/article pages,
    which Google's breadcrumb spec expects even though this theme
    doesn't print the current page's own name in the visible trail
    there (collection/page/search already do).
  {%- endcomment -%}
  {%- assign pm_crumbs = 'general.breadcrumbs.home' | t | append: '::' | append: routes.root_url | append: ';;' -%}

  <nav class="breadcrumb" role="navigation" aria-label="breadcrumbs">
    <a href="{{ routes.root_url }}" title="{{ 'general.breadcrumbs.home_link_title' | t }}">{{ 'general.breadcrumbs.home' | t }}</a>

    {% if template.name == 'product' %}

      {%- comment -%}
        `collection` is only set when the URL carries collection
        context (/collections/X/products/Y, or /products/Y?collection=X)
        -- which most arrivals don't have: direct product links, search
        results, homepage/recommendation tiles and Google traffic all
        land on the plain /products/Y URL. Falling back to
        product.collections (every real Collection this product
        belongs to) means the breadcrumb -- and its link back to the
        right category -- still shows up on those, instead of just
        "Home / Product Name" with nothing in between. Checked in a
        fixed priority order against the 4 real category Collections
        (same ones the Shop page filters link to) plus AW27 last, so
        it's deterministic even if a product sits in more than one.
      {%- endcomment -%}
      {%- assign breadcrumb_collection = collection -%}
      {%- if breadcrumb_collection == nil or breadcrumb_collection.handle == blank -%}
        {%- assign pm_breadcrumb_handles = 'clutches,jewelry-and-accessories,mini-bags,fits-a-phone,aw27' | split: ',' -%}
        {%- for pm_handle in pm_breadcrumb_handles -%}
          {%- if breadcrumb_collection == nil or breadcrumb_collection.handle == blank -%}
            {%- assign pm_match = product.collections | where: 'handle', pm_handle | first -%}
            {%- if pm_match -%}
              {%- assign breadcrumb_collection = pm_match -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {% if breadcrumb_collection %}
        {% if settings.show_breadcrumbs_collection_link %}
          <span class="breadcrumb__divider" aria-hidden="true">/</span>
          <a href="{{ routes.collections_url }}">{{ 'general.search.collections' | t | replace: ':', ''}}</a>
          {%- assign pm_crumbs = pm_crumbs | append: 'Collections::' | append: routes.collections_url | append: ';;' -%}
        {% endif %}

        <span class="breadcrumb__divider" aria-hidden="true">/</span>
        {% if breadcrumb_collection.handle %}
          {% capture url %}{{ routes.collections_url }}/{{ breadcrumb_collection.handle }}{% endcapture %}
          {{ breadcrumb_collection.title | link_to: url }}
          {%- assign pm_crumbs = pm_crumbs | append: breadcrumb_collection.title | append: '::' | append: url | append: ';;' -%}
        {% endif %}
      {% endif %}
      <span class="breadcrumb__divider" aria-hidden="true">/</span>
      {%- assign pm_crumbs = pm_crumbs | append: product.title | append: '::' | append: product.url | append: ';;' -%}

    {% elsif template.name == 'collection' and collection.handle %}
      {% if settings.show_breadcrumbs_collection_link %}
        <span class="breadcrumb__divider" aria-hidden="true">/</span>
        <a href="{{ routes.collections_url }}">{{ 'general.search.collections' | t | replace: ':', ''}}</a>
        {%- assign pm_crumbs = pm_crumbs | append: 'Collections::' | append: routes.collections_url | append: ';;' -%}
      {% endif %}

      <span class="breadcrumb__divider" aria-hidden="true">/</span>

      {% if current_tags %}

        {% capture url %}{{ routes.collections_url }}/{{ collection.handle }}{% endcapture %}
        {{ collection.title | link_to: url }}
        {%- assign pm_crumbs = pm_crumbs | append: collection.title | append: '::' | append: url | append: ';;' -%}

        <span class="breadcrumb__divider" aria-hidden="true">/</span>

        {%- assign pm_tag_labels = '' -%}
        {% for tag in current_tags %}
          {% if tag contains "_" %}{%- assign tag_starts_with = tag | slice: 0 -%}{% if tag_starts_with == "_" %}{% if tag_count %}{%- assign tag_count = tag_count | minus: 1 | at_least: 0 -%}{% endif %}{% continue %}{% endif %}{% endif %}

          {% assign tag_name = tag | strip %}
          {% assign tag_text = tag_name | capitalize %}
          <span>{{ tag_text }}</span>
          {%- assign pm_tag_labels = pm_tag_labels | append: tag_text -%}

          {% unless forloop.last %}
            <span>+</span>
            {%- assign pm_tag_labels = pm_tag_labels | append: ' + ' -%}
          {% endunless %}

        {% endfor %}
        {%- assign pm_crumbs = pm_crumbs | append: pm_tag_labels | append: '::' | append: canonical_url | append: ';;' -%}
      {% else %}
        {%- assign pm_crumbs = pm_crumbs | append: collection.title | append: '::' | append: collection.url | append: ';;' -%}
      {% endif %}

    {% elsif template.name == 'blog' %}

      <span class="breadcrumb__divider" aria-hidden="true">/</span>
      {% if current_tags %}
        {{ blog.title | link_to: blog.url }}
        {%- assign pm_crumbs = pm_crumbs | append: blog.title | append: '::' | append: blog.url | append: ';;' -%}
        <span class="breadcrumb__divider" aria-hidden="true">/</span>
        <span>{{ current_tags | join: " + " }}</span>
        {%- assign pm_blog_tag_label = current_tags | join: ' + ' -%}
        {%- assign pm_crumbs = pm_crumbs | append: pm_blog_tag_label | append: '::' | append: canonical_url | append: ';;' -%}
      {% else %}
        {%- assign pm_crumbs = pm_crumbs | append: blog.title | append: '::' | append: blog.url | append: ';;' -%}
      {% endif %}

    {% elsif template.name == 'article' %}

      <span class="breadcrumb__divider" aria-hidden="true">/</span>
      {{ blog.title | link_to: blog.url }}
      <span class="breadcrumb__divider" aria-hidden="true">/</span>
      {%- assign pm_crumbs = pm_crumbs | append: blog.title | append: '::' | append: blog.url | append: ';;' -%}
      {%- assign pm_crumbs = pm_crumbs | append: article.title | append: '::' | append: article.url | append: ';;' -%}

    {% elsif template.name == 'page' %}

      <span class="breadcrumb__divider" aria-hidden="true">/</span>
      <span>{{ page.title }}</span>
      {%- assign pm_crumbs = pm_crumbs | append: page.title | append: '::' | append: page.url | append: ';;' -%}

    {% elsif template.name == 'search' %}

      <span class="breadcrumb__divider" aria-hidden="true">/</span>
      <span>{{ page_title | replace: '*', '' }}</span>
      {%- assign pm_search_label = page_title | replace: '*', '' -%}
      {%- assign pm_crumbs = pm_crumbs | append: pm_search_label | append: '::' | append: canonical_url | append: ';;' -%}

    {% else %}

      <span class="breadcrumb__divider" aria-hidden="true">/</span>
      <span>{{ page_title }}</span>
      {%- assign pm_crumbs = pm_crumbs | append: page_title | append: '::' | append: canonical_url | append: ';;' -%}

    {% endif %}
  </nav>

  {%- comment -%}
    BreadcrumbList structured data, parsed from pm_crumbs above. Every
    branch's final append ends with the ';;' delimiter, which would
    otherwise leave a trailing blank entry after split -- trimmed off
    here first so forloop.last (used for the comma between JSON
    objects) lines up with the real last item instead of that blank
    one. Each label goes through the `json` filter rather than manual
    escaping, so quotes/backslashes/unicode in a product or page
    title can't break the script tag.
  {%- endcomment -%}
  {%- assign pm_crumbs_trimmed = pm_crumbs | slice: 0, pm_crumbs.size | minus: 2 -%}
  {%- assign pm_crumb_list = pm_crumbs_trimmed | split: ';;' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {%- for pm_crumb in pm_crumb_list -%}
        {%- assign pm_crumb_parts = pm_crumb | split: '::' -%}
        {
          "@type": "ListItem",
          "position": {{ forloop.index }},
          "name": {{ pm_crumb_parts[0] | json }},
          "item": {{ pm_crumb_parts[1] | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
  </script>
{% endunless %}

{% endif %}
