{%- comment -%}
  description_override (optional): the product-template.liquid caller
  splits product.description at the "Materials & dimensions" heading
  and passes just the part before it here, so that section can show
  in its own "Product Details" drawer instead (see product-template.liquid,
  right after the 'contact' block case). Falls back to the full
  product.description when not provided, or when no such heading
  exists in this product's description yet.
{%- endcomment -%}
{% capture description %}
  {%- if product.empty? -%}
    {{ 'home_page.onboarding.product_description' | t }}
  {%- elsif description_override != blank -%}
    {{ description_override }}
  {%- else -%}
    {{ product.description }}
  {%- endif -%}
{% endcapture %}
{%- if is_tab -%}
  {% assign title = 'products.product.description' | t %}
  {%- render 'tab', id: id, title: title, content: description -%}
{%- else -%}
  <div class="pm-product-description">
    <div class="rte">
      {%- comment -%}
        "Description" now renders as a real h2 inside .rte, the same
        as "Fit Notes" etc. within the description text itself, so it
        picks up the identical serif heading style (.pm-product-description
        .rte h1-h4 in pm-product.css) instead of the small uppercase
        .pm-eyebrow label style it had before, which looked like a
        different, unrelated kind of heading next to it.
      {%- endcomment -%}
      <h2>{{ 'products.product.description' | t }}</h2>
      {{ description }}
    </div>
  </div>
{%- endif -%}
