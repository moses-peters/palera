{%- comment -%}
  URL for one family: its own Shopify collection when it exists (locale-aware,
  e.g. /it/collections/pouches), otherwise the old /collections/all?family=...
  filter. Params: handle (family handle, e.g. 'pouches'), collection (the
  collection handle from pm-family-data's 4th field).
{%- endcomment -%}
{%- assign pm_fam_coll = nil -%}
{%- if collection != blank -%}{%- assign pm_fam_coll = collections[collection] -%}{%- endif -%}
{%- if pm_fam_coll and pm_fam_coll.url != blank -%}
  {{- pm_fam_coll.url -}}
{%- else -%}
  {{- routes.all_products_collection_url | default: '/collections/all' -}}?family={{ handle }}
{%- endif -%}
